# Infrastructure variables forwarded by compose.yaml. Blank secrets fail validation.
# Generate the real file on the deployment host with: python3 prepare-env.py
SERVER_URL=https://os.connectxmedia.com
PG_DATABASE_USER=twenty
PG_DATABASE_NAME=twenty
PG_DATABASE_PASSWORD=
ENCRYPTION_KEY=
# New installation: APP_SECRET and FALLBACK_ENCRYPTION_KEY are deliberately unset.
# Configure optional SMTP, OAuth and AI providers in Twenty's admin panel.
