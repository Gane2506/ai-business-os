# Copy to .env, replace all credentials, and restrict the file to the deploy user.
TENANT_SLUG=connectx
MAUTIC_HOST=marketing.connectxmedia.com
PROXY_NETWORK=web
TZ=America/Toronto
AI_OS_SES_ROOT_DOMAIN=connectxmedia.com
# Remain disabled until runtime plugin/IAM/unsubscribe acceptance; no test sends are authorized.
AI_OS_SES_SEND_ENABLED=false
# Set privately to smtps://URL_ENCODED_USER:URL_ENCODED_SMTP_PASSWORD@email-smtp.ca-central-1.amazonaws.com:465
# SMTP credentials are regional and differ from AWS API secret access keys.
MAUTIC_MAILER_DSN=null://null
# Same >=32-character secret as backend EMAIL_MAUTIC_FEEDBACK_SECRET; leave empty until securely provisioned.
AI_OS_SES_FEEDBACK_SECRET=

# Official, multi-platform Mautic Apache and MySQL images pinned to manifest-list digests.
# Refresh pins deliberately after review; do not switch to mutable tags such as latest.
MAUTIC_IMAGE=mautic/mautic:7.2.1-20260923-apache@sha256:ff584fd13c8db06b4a7dd640e837dbbde69bd8c40da62140ff6c3c2dd0402abc
MYSQL_IMAGE=mysql:8.4.7@sha256:0426ec38c7a10aa45ba383887df7878f74ee70e2fd589c7b69207f3577901903

MYSQL_DATABASE=mautic
MYSQL_USER=mautic
MYSQL_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_UNIQUE_RANDOM_PASSWORD
