# DRAFT: Better Auth migration is pending; do not deploy this template yet.
# Copy to runtime.env; chmod 600. Complete all REQUIRED entries before startup.
# This is a name-only template, not a validated credential inventory.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
APP_ENCRYPTION_SECRET=
OPENAI_API_KEY=
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_CALL_CONTROL_APP_ID=
TELNYX_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WHATSAPP_PHONE_ID=
WHATSAPP_PHONE_NUMBER=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
AWS_SES_REGION=ca-central-1
# AWS credentials use the standard AWS SDK chain (role/profile/environment).
# Do not copy connector credentials into this template.
EMAIL_FROM_NAME=ConnectX Media
EMAIL_FROM_ADDRESS=noreply@mail.connectxmedia.com
# Optional monitored support inbox; configure independently of the noreply sender.
INTERNAL_SUPPORT_EMAIL=
# Set explicitly to avoid the upstream founders' fallback allowlist.
BACKOFFICE_SUPER_ADMIN_EMAILS=
# Exact trusted reverse-proxy path must be verified before setting above zero.
TRUST_PROXY_HOPS=0
# Optional feature settings. Empty means unavailable, not a test credential.
DEEPGRAM_API_KEY=
TRANSCRIPTION_MEDIA_STREAM_PUBLIC_URL=wss://calls-api.connectxmedia.com/media-stream
TELNYX_MESSAGING_PROFILE_ID=
DESK_PHONES_ENABLED=false
ENRICHMENT_FEATURE_ENABLED=false
AI_FOLLOWUP_AI_ENABLED=false
AI_OBJECTION_AI_ENABLED=false
# Local upload URLs currently require a separate authenticated serving solution.
# Do not expose this mount with an unauthenticated Nginx /uploads alias.
