+-- FRESH INSTALL ONLY. Generated with Prisma 6.16.3 from schema.prisma.
+-- Historical pending ALTERs/backfills must not be replayed after this baseline.
+-- Existing deployments need a separately reviewed migration-adoption plan.
+-- Refuse pre-existing application objects even if Prisma history was initialized.
+DO $$
+BEGIN
+  IF EXISTS (
+    SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
+    WHERE n.nspname = current_schema()
+      AND c.relkind IN ('r', 'p', 'v', 'm', 'S', 'f')
+      AND c.relname <> '_prisma_migrations'
+  ) OR EXISTS (
+    SELECT 1 FROM pg_type t JOIN pg_namespace n ON n.oid = t.typnamespace
+    WHERE n.nspname = current_schema() AND t.typtype IN ('e', 'd')
+  ) THEN
+    RAISE EXCEPTION 'Fresh-install baseline requires an empty target schema. Existing databases require a reviewed adoption plan.';
+  END IF;
+END $$;
