--- /dev/null
+++ b/packages/agent/src/clients/mcp-client.test.ts
@@ -0,0 +1,31 @@
+import assert from "node:assert/strict";
+import { createServer } from "node:http";
+import { it } from "node:test";
+import { RingeeMcpClient, RingeeMcpError } from "./mcp-client.js";
+
+it("explains how to migrate when the server retires a legacy SSE URL", async () => {
+  const server = createServer((_req, res) => {
+    res.writeHead(410, { "Content-Type": "application/json" });
+    res.end(JSON.stringify({ message: "UUID URLs disabled" }));
+  });
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address();
+  assert.ok(address && typeof address !== "string");
+  const client = new RingeeMcpClient({
+    url: `http://127.0.0.1:${address.port}/api/mcp/11111111-1111-4111-8111-111111111111/sse`,
+  });
+  try {
+    await assert.rejects(client.connect(), (error: unknown) => {
+      assert.ok(error instanceof RingeeMcpError);
+      assert.match(error.message, /retired/);
+      assert.match(error.message, /ringee login/);
+      assert.match(error.message, /RINGEE_API_KEY/);
+      return true;
+    });
+  } finally {
+    await client.close();
+    await new Promise<void>((resolve, reject) =>
+      server.close((error) => (error ? reject(error) : resolve())),
+    );
+  }
+});
