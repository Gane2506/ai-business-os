+-- Run only against a disposable bootstrap validation database with psql -v ON_ERROR_STOP=1.
+-- Every synthetic fixture is rolled back, including when an assertion fails.
+BEGIN;
+DO $$
+DECLARE
+  user_a uuid := gen_random_uuid();
+  user_b uuid := gen_random_uuid();
+  org_a uuid := gen_random_uuid();
+  org_b uuid := gen_random_uuid();
+  call_id uuid := gen_random_uuid();
+  company_id uuid;
+  repeated_id uuid;
+  attempt_id uuid := gen_random_uuid();
+  number_id uuid := gen_random_uuid();
+  expected_index text;
+  constraint_name text;
+BEGIN
+  FOREACH expected_index IN ARRAY ARRAY[
+    'DNCEntry_org_phone_unique', 'DNCEntry_user_phone_unique',
+    'Company_organizationId_normalizedName_active_key',
+    'Company_userId_normalizedName_active_key',
+    'Call_open_inboundTransferRequestedAt_idx'
+  ] LOOP
+    IF NOT EXISTS (
+      SELECT 1 FROM pg_index i JOIN pg_class c ON c.oid = i.indexrelid
+      JOIN pg_namespace n ON n.oid = c.relnamespace
+      WHERE n.nspname = current_schema() AND c.relname = expected_index
+        AND i.indisvalid AND i.indpred IS NOT NULL
+    ) THEN
+      RAISE EXCEPTION 'Missing valid partial index: %', expected_index;
+    END IF;
+  END LOOP;
+
+  INSERT INTO "User" ("id", "updatedAt") VALUES (user_a, now()), (user_b, now());
+  INSERT INTO "Organization" ("id", "clerkId", "name", "updatedAt")
+    VALUES (org_a, org_a::text, 'Bootstrap A', now()), (org_b, org_b::text, 'Bootstrap B', now());
+
+  -- The same phone may occur in distinct personal/org workspaces.
+  INSERT INTO "DNCEntry" ("id", "userId", "organizationId", "phoneNumber") VALUES
+    (gen_random_uuid(), user_a, NULL, '+14165550100'),
+    (gen_random_uuid(), user_b, NULL, '+14165550100'),
+    (gen_random_uuid(), user_a, org_a, '+14165550100'),
+    (gen_random_uuid(), user_a, org_b, '+14165550100');
+  BEGIN
+    INSERT INTO "DNCEntry" ("id", "userId", "phoneNumber")
+      VALUES (gen_random_uuid(), user_a, '+14165550100');
+    RAISE EXCEPTION 'Duplicate personal DNC entry was accepted';
+  EXCEPTION WHEN unique_violation THEN
+    GET STACKED DIAGNOSTICS constraint_name = CONSTRAINT_NAME;
+    IF constraint_name <> 'DNCEntry_user_phone_unique' THEN RAISE; END IF;
+  END;
+  BEGIN
+    INSERT INTO "DNCEntry" ("id", "userId", "organizationId", "phoneNumber")
+      VALUES (gen_random_uuid(), user_b, org_a, '+14165550100');
+    RAISE EXCEPTION 'Duplicate organization DNC entry was accepted';
+  EXCEPTION WHEN unique_violation THEN
+    GET STACKED DIAGNOSTICS constraint_name = CONSTRAINT_NAME;
+    IF constraint_name <> 'DNCEntry_org_phone_unique' THEN RAISE; END IF;
+  END;
+
+  -- Exercise the exact ON CONFLICT predicates used by CompanyRepository.
+  INSERT INTO "Company" ("id", "name", "normalizedName", "userId", "updatedAt")
+    VALUES (gen_random_uuid(), 'Bootstrap', 'bootstrap', user_a, now()) RETURNING "id" INTO company_id;
+  INSERT INTO "Company" ("id", "name", "normalizedName", "userId", "updatedAt")
+    VALUES (gen_random_uuid(), 'Bootstrap', 'bootstrap', user_a, now())
+    ON CONFLICT ("userId", "normalizedName") WHERE "deletedAt" IS NULL AND "organizationId" IS NULL
+    DO UPDATE SET "name" = EXCLUDED."name" RETURNING "id" INTO repeated_id;
+  IF repeated_id <> company_id THEN RAISE EXCEPTION 'Personal company upsert did not deduplicate'; END IF;
+  INSERT INTO "Company" ("id", "name", "normalizedName", "userId", "organizationId", "updatedAt")
+    VALUES (gen_random_uuid(), 'Bootstrap', 'bootstrap', user_a, org_a, now()) RETURNING "id" INTO company_id;
+  INSERT INTO "Company" ("id", "name", "normalizedName", "userId", "organizationId", "updatedAt")
+    VALUES (gen_random_uuid(), 'Bootstrap', 'bootstrap', user_b, org_a, now())
+    ON CONFLICT ("organizationId", "normalizedName") WHERE "deletedAt" IS NULL AND "organizationId" IS NOT NULL
+    DO UPDATE SET "name" = EXCLUDED."name" RETURNING "id" INTO repeated_id;
+  IF repeated_id <> company_id THEN RAISE EXCEPTION 'Organization company upsert did not deduplicate'; END IF;
+  INSERT INTO "Company" ("id", "name", "normalizedName", "userId", "organizationId", "updatedAt") VALUES
+    (gen_random_uuid(), 'Bootstrap', 'bootstrap', user_b, NULL, now()),
+    (gen_random_uuid(), 'Bootstrap', 'bootstrap', user_a, org_b, now());
+  UPDATE "Company" SET "deletedAt" = now() WHERE "id" = company_id;
+  INSERT INTO "Company" ("id", "name", "normalizedName", "userId", "organizationId", "updatedAt")
+    VALUES (gen_random_uuid(), 'Bootstrap', 'bootstrap', user_a, org_a, now());
+
+  -- The SQL-only inbound route check requires exactly one number.
+  INSERT INTO "NumberPurchased" ("id", "phoneNumber", "isoCountry", "updatedAt")
+    VALUES (number_id, '+14165550101', 'CA', now());
+  INSERT INTO "InboundRoute" ("id", "userId", "numberId", "destinationType", "destinationId", "updatedAt")
+    VALUES (gen_random_uuid(), user_a, number_id, 'user', user_a, now());
+  BEGIN
+    INSERT INTO "InboundRoute" ("id", "userId", "destinationType", "destinationId", "updatedAt")
+      VALUES (gen_random_uuid(), user_a, 'user', user_a, now());
+    RAISE EXCEPTION 'Inbound route without a number was accepted';
+  EXCEPTION WHEN check_violation THEN
+    GET STACKED DIAGNOSTICS constraint_name = CONSTRAINT_NAME;
+    IF constraint_name <> 'InboundRoute_one_number' THEN RAISE; END IF;
+  END;
+  BEGIN
+    INSERT INTO "InboundRoute" ("id", "userId", "numberId", "externalNumberId", "destinationType", "destinationId", "updatedAt")
+      VALUES (gen_random_uuid(), user_a, gen_random_uuid(), gen_random_uuid(), 'user', user_a, now());
+    RAISE EXCEPTION 'Inbound route with two numbers was accepted';
+  EXCEPTION WHEN check_violation THEN
+    GET STACKED DIAGNOSTICS constraint_name = CONSTRAINT_NAME;
+    IF constraint_name <> 'InboundRoute_one_number' THEN RAISE; END IF;
+  END;
+
+  INSERT INTO "Call" ("id", "fromNumber", "toNumber", "updatedAt")
+    VALUES (call_id, '+14165550100', '+14165550101', now());
+  INSERT INTO "InboundRingAttempt" ("id", "callId", "userId") VALUES (attempt_id, call_id, user_a);
+  IF (SELECT "endpointKey" FROM "InboundRingAttempt" WHERE "id" = attempt_id) <> 'user:' || user_a::text THEN
+    RAISE EXCEPTION 'Legacy endpoint key trigger did not derive the user key';
+  END IF;
+  BEGIN
+    INSERT INTO "InboundRingAttempt" ("id", "callId", "userId") VALUES (gen_random_uuid(), call_id, user_a);
+    RAISE EXCEPTION 'Duplicate legacy ring attempt was accepted';
+  EXCEPTION WHEN unique_violation THEN
+    GET STACKED DIAGNOSTICS constraint_name = CONSTRAINT_NAME;
+    IF constraint_name <> 'InboundRingAttempt_callId_endpointKey_key' THEN RAISE; END IF;
+  END;
+  attempt_id := gen_random_uuid();
+  INSERT INTO "InboundRingAttempt" ("id", "callId") VALUES (attempt_id, call_id);
+  IF (SELECT "endpointKey" FROM "InboundRingAttempt" WHERE "id" = attempt_id) <> 'legacy:' || attempt_id::text THEN
+    RAISE EXCEPTION 'Legacy endpoint key trigger did not derive the fallback key';
+  END IF;
+  attempt_id := gen_random_uuid();
+  INSERT INTO "InboundRingAttempt" ("id", "callId", "endpointKey") VALUES (attempt_id, call_id, 'browser:explicit');
+  IF (SELECT "endpointKey" FROM "InboundRingAttempt" WHERE "id" = attempt_id) <> 'browser:explicit' THEN
+    RAISE EXCEPTION 'Legacy endpoint key trigger changed an explicit key';
+  END IF;
+END $$;
+ROLLBACK;
