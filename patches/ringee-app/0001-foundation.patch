diff --git a/apps/backend/src/api/routes/mcp.controller.spec.ts b/apps/backend/src/api/routes/mcp.controller.spec.ts
new file mode 100644
index 0000000..df32802
--- /dev/null
+++ b/apps/backend/src/api/routes/mcp.controller.spec.ts
@@ -0,0 +1,249 @@
+/// <reference types="node" />
+
+import "reflect-metadata";
+import assert from "node:assert/strict";
+import { after, before, beforeEach, describe, it } from "node:test";
+import {
+  Module,
+  UnauthorizedException,
+  type INestApplication,
+} from "@nestjs/common";
+import { NestFactory } from "@nestjs/core";
+import type { Response } from "express";
+import { hashOpaqueSecret } from "@ringee/platform";
+import { PersonalApiKeyService } from "@ringee/services";
+import { McpService } from "../../mcp/mcp.service";
+import { McpController } from "./mcp.controller";
+import { PersonalApiKeyGuard } from "../guards/personal-api-key.guard";
+
+const USER = "11111111-1111-4111-8111-111111111111";
+const ORG = "22222222-2222-4222-8222-222222222222";
+const OTHER_ORG = "33333333-3333-4333-8333-333333333333";
+const KEY = `ringee_sk_${"a".repeat(64)}`;
+const REVOKED_KEY = `ringee_sk_${"b".repeat(64)}`;
+const BLOCKED_KEY = `ringee_sk_${"c".repeat(64)}`;
+
+type KeyRepo = ConstructorParameters<typeof PersonalApiKeyService>[0];
+type UserRepo = ConstructorParameters<typeof PersonalApiKeyService>[1];
+type Organizations = ConstructorParameters<typeof PersonalApiKeyService>[2];
+
+let workspace: string | null = ORG;
+let workspaceDenied = false;
+let lookups = 0;
+const calls: Array<{ method: string; args: unknown[] }> = [];
+const rows = new Map(
+  [KEY, REVOKED_KEY, BLOCKED_KEY].map((key) => [
+    hashOpaqueSecret(key),
+    {
+      id: `key-${key[10]}`,
+      userId: USER,
+      source: "dashboard",
+      revokedAt: key === REVOKED_KEY ? new Date() : null,
+      user: { id: USER, blockedAt: key === BLOCKED_KEY ? new Date() : null },
+      lastUsedAt: new Date(),
+    },
+  ]),
+);
+const apiKeys = new PersonalApiKeyService(
+  {
+    async findByHash(hash: string) {
+      lookups++;
+      return rows.get(hash) ?? null;
+    },
+    async touch() {},
+  } as unknown as KeyRepo,
+  {} as UserRepo,
+  {
+    async getActiveWorkspaceOrgId(userId: string) {
+      assert.equal(userId, USER);
+      if (workspaceDenied) throw new UnauthorizedException("Workspace denied");
+      return workspace;
+    },
+  } as unknown as Organizations,
+);
+
+const mcp = {
+  async handleStreamableRequest(...args: unknown[]) {
+    calls.push({ method: "streamable", args });
+    (args[2] as Response).status(200).json({ ok: true });
+  },
+  async openSseSession(...args: unknown[]) {
+    calls.push({ method: "sse", args });
+    // End the stream in this harness; transport implementation is unchanged.
+    (args[2] as Response).status(200).send("data: connected\n\n");
+  },
+  async handlePostMessage(...args: unknown[]) {
+    calls.push({ method: "messages", args });
+    (args[3] as Response).status(202).json({ ok: true });
+  },
+};
+
+@Module({
+  controllers: [McpController],
+  providers: [
+    PersonalApiKeyGuard,
+    { provide: PersonalApiKeyService, useValue: apiKeys },
+    { provide: McpService, useValue: mcp },
+  ],
+})
+class TestModule {}
+
+describe("MCP HTTP authorization boundary", () => {
+  let app: INestApplication;
+  let base: string;
+
+  before(async () => {
+    app = await NestFactory.create(TestModule, { logger: false });
+    app.setGlobalPrefix("api");
+    await app.listen(0, "127.0.0.1");
+    base = await app.getUrl();
+  });
+  after(async () => {
+    await app?.close();
+  });
+  beforeEach(() => {
+    calls.length = 0;
+    lookups = 0;
+    workspace = ORG;
+    workspaceDenied = false;
+  });
+
+  async function request(path: string, method = "GET", key?: string) {
+    return fetch(`${base}/api/mcp${path}`, {
+      method,
+      headers: {
+        "Content-Type": "application/json",
+        ...(key ? { Authorization: `Bearer ${key}` } : {}),
+      },
+      ...(method === "POST"
+        ? {
+            body: JSON.stringify({
+              userId: "attacker",
+              organizationId: OTHER_ORG,
+            }),
+          }
+        : {}),
+    });
+  }
+
+  for (const scope of [USER, ORG, `${USER}/${ORG}`]) {
+    for (const [suffix, method] of [
+      ["sse", "GET"],
+      ["messages?sessionId=leaked-session", "POST"],
+    ]) {
+      it(`denies leaked UUID ${scope}/${suffix} without MCP dispatch`, async () => {
+        const response = await request(`/${scope}/${suffix}`, method);
+        assert.equal(response.status, 410);
+        assert.match((await response.json()).message, /API key/);
+        assert.equal(calls.length, 0);
+        assert.equal(lookups, 0);
+      });
+    }
+  }
+
+  it("never revives a UUID URL even with a valid API key", async () => {
+    for (const [path, method] of [
+      [`/${USER}/sse`, "GET"],
+      [`/${USER}/${ORG}/messages`, "POST"],
+    ]) {
+      assert.equal((await request(path, method, KEY)).status, 410);
+    }
+    assert.equal(calls.length, 0);
+    assert.equal(lookups, 0);
+  });
+
+  const authenticatedRoutes = [
+    ["", "POST"],
+    ["/sse", "GET"],
+    ["/messages?sessionId=session", "POST"],
+  ];
+  for (const [path, method] of authenticatedRoutes) {
+    it(`requires a key on ${method} ${path || "/"}`, async () => {
+      const response = await request(path, method);
+      assert.equal(response.status, 401);
+      assert.match(response.headers.get("www-authenticate") ?? "", /Bearer/);
+      assert.equal(calls.length, 0);
+    });
+
+    for (const [label, key, status] of [
+      ["unknown", `ringee_sk_${"d".repeat(64)}`, 401],
+      ["revoked", REVOKED_KEY, 401],
+      ["blocked", BLOCKED_KEY, 403],
+    ] as const) {
+      it(`denies ${label} key on ${method} ${path || "/"}`, async () => {
+        assert.equal((await request(path, method, key)).status, status);
+        assert.equal(calls.length, 0);
+      });
+    }
+
+    it(`fails closed when workspace resolution fails on ${method} ${path || "/"}`, async () => {
+      workspaceDenied = true;
+      assert.equal((await request(path, method, KEY)).status, 401);
+      assert.equal(calls.length, 0);
+    });
+  }
+
+  it("passes the authenticated identity to unchanged Streamable HTTP dispatch", async () => {
+    assert.equal((await request("", "POST", KEY)).status, 200);
+    assert.equal(calls[0].method, "streamable");
+    assert.deepEqual((calls[0].args[0] as { ctx: unknown }).ctx, {
+      userId: USER,
+      organizationId: ORG,
+    });
+    assert.equal(lookups, 1);
+  });
+
+  it("passes SSE path and API-key attribution through, ignoring client IDs", async () => {
+    assert.equal((await request("/sse", "GET", KEY)).status, 200);
+    assert.equal(calls[0].method, "sse");
+    assert.deepEqual(calls[0].args[0], { userId: USER, organizationId: ORG });
+    assert.equal(calls[0].args[1], "/api/mcp/messages");
+    assert.deepEqual(calls[0].args[3], {
+      authMethod: "api_key",
+      apiKeyId: rows.get(hashOpaqueSecret(KEY))!.id,
+      apiKeySource: "dashboard",
+    });
+  });
+
+  it("re-resolves the active workspace on each authenticated message", async () => {
+    for (const organizationId of [ORG, null]) {
+      workspace = organizationId;
+      assert.equal(
+        (await request("/messages?sessionId=session", "POST", KEY)).status,
+        202,
+      );
+      const call = calls.at(-1)!;
+      assert.equal(call.method, "messages");
+      assert.deepEqual(call.args[0], { userId: USER, organizationId });
+      assert.equal(call.args[1], "session");
+      assert.deepEqual(call.args[5], {
+        authMethod: "api_key",
+        apiKeyId: rows.get(hashOpaqueSecret(KEY))!.id,
+        apiKeySource: "dashboard",
+      });
+    }
+  });
+
+  it("keeps authenticated message validation and stateless HTTP method responses", async () => {
+    assert.equal((await request("/messages", "POST", KEY)).status, 400);
+    assert.equal(calls.length, 0);
+    for (const method of ["GET", "DELETE"]) {
+      const response = await request("", method);
+      assert.equal(response.status, 405);
+      assert.equal(response.headers.get("allow"), "POST");
+    }
+  });
+
+  it("does not advertise UUID URLs in connection-info", async () => {
+    const controller = app.get(McpController);
+    for (const activeOrgId of [ORG, null]) {
+      const info = await controller.connectionInfo({
+        id: USER,
+        activeOrgId,
+      } as Parameters<McpController["connectionInfo"]>[0]);
+      assert.equal("url" in info, false);
+      assert.ok(info.endpoint.endsWith("/api/mcp"));
+      assert.ok(info.sseEndpoint.endsWith("/api/mcp/sse"));
+    }
+  });
+});
