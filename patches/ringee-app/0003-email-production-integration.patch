diff --git a/packages/platform/src/auth/better-auth/runtime.mjs b/packages/platform/src/auth/better-auth/runtime.mjs
new file mode 100644
index 0000000..e175b1a
--- /dev/null
+++ b/packages/platform/src/auth/better-auth/runtime.mjs
@@ -0,0 +1,173 @@
+import { betterAuth } from "better-auth/minimal";
+import { prismaAdapter } from "better-auth/adapters/prisma";
+import {
+  hashedSessionAdapter,
+  DISABLED_SESSION_ROUTES,
+} from "./hashed-session-adapter.mjs";
+
+// Recovery/OAuth verification is deliberately disabled until the protected store
+// and lifecycle transport are composed. Column names alone do not encrypt values.
+function credentialOnlyAdapter(factory) {
+  function wrap(adapter) {
+    return new Proxy(adapter, {
+      get(target, property) {
+        if (
+          property === "transaction" &&
+          typeof target.transaction === "function"
+        ) {
+          return (callback) => target.transaction((tx) => callback(wrap(tx)));
+        }
+        const value = Reflect.get(target, property);
+        if (typeof value !== "function") return value;
+        return (args, ...rest) => {
+          if (args?.model === "verification")
+            throw new Error("Verification lifecycle is disabled");
+          return value.call(target, args, ...rest);
+        };
+      },
+    });
+  }
+  return (options) => wrap(factory(options));
+}
+
+const BASE_URL = "https://calls-api.connectxmedia.com";
+const ORIGINS = new Set([
+  BASE_URL,
+  "https://calls.connectxmedia.com",
+  "https://os.connectxmedia.com",
+  "https://marketing.connectxmedia.com",
+]);
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+export function createRuntime(client, configuration) {
+  if (
+    configuration?.baseURL !== BASE_URL ||
+    typeof configuration.secret !== "string" ||
+    configuration.secret.length < 32 ||
+    !Array.isArray(configuration.trustedOrigins) ||
+    !configuration.trustedOrigins.length ||
+    configuration.trustedOrigins.some((origin) => !ORIGINS.has(origin))
+  ) {
+    throw new Error("Invalid Better Auth configuration");
+  }
+  const auth = betterAuth({
+    baseURL: BASE_URL,
+    basePath: "/api/auth",
+    secret: configuration.secret,
+    trustedOrigins: [...configuration.trustedOrigins],
+    database: credentialOnlyAdapter(
+      hashedSessionAdapter(
+        prismaAdapter(client, { provider: "postgresql", transaction: true }),
+      ),
+    ),
+    user: {
+      modelName: "User",
+      fields: {
+        name: "authName",
+        email: "authEmail",
+        emailVerified: "authEmailVerified",
+        image: "imageUrl",
+      },
+    },
+    session: {
+      modelName: "AuthSession",
+      fields: { token: "tokenHash" },
+      cookieCache: { enabled: false },
+      additionalFields: {
+        activeOrganizationId: { type: "string", required: false, input: false },
+      },
+    },
+    account: {
+      modelName: "AuthAccount",
+      fields: {
+        password: "passwordHash",
+        accessToken: "accessTokenEncrypted",
+        refreshToken: "refreshTokenEncrypted",
+        idToken: "idTokenEncrypted",
+      },
+      accountLinking: { enabled: false },
+    },
+    verification: {
+      modelName: "AuthVerification",
+      fields: { identifier: "identifierHash", value: "valueEncrypted" },
+    },
+    emailAndPassword: {
+      enabled: true,
+      disableSignUp: true,
+      requireEmailVerification: true,
+    },
+    emailVerification: { sendOnSignIn: false, sendOnSignUp: false },
+    advanced: {
+      database: { generateId: "uuid" },
+      cookiePrefix: "ai-business-os",
+      useSecureCookies: true,
+      crossSubDomainCookies: { enabled: true, domain: "connectxmedia.com" },
+      defaultCookieAttributes: {
+        secure: true,
+        httpOnly: true,
+        sameSite: "lax",
+        path: "/",
+      },
+      disableOriginCheck: false,
+      disableCSRFCheck: false,
+    },
+    disabledPaths: DISABLED_SESSION_ROUTES,
+    telemetry: { enabled: false },
+    logger: { disabled: true },
+  });
+  return Object.freeze({
+    async getVerifiedSession(headers) {
+      const result = await auth.api.getSession({ headers });
+      if (
+        !result ||
+        !UUID.test(result.session.id) ||
+        !UUID.test(result.user.id) ||
+        result.session.userId !== result.user.id ||
+        new Date(result.session.expiresAt).getTime() <= Date.now()
+      )
+        return null;
+      return { id: result.session.id, userId: result.user.id };
+    },
+    async handle(request) {
+      const url = new URL(request.url);
+      if (
+        url.origin !== BASE_URL ||
+        request.method !== "POST" ||
+        !["/api/auth/sign-in/email", "/api/auth/sign-out"].includes(
+          url.pathname,
+        ) ||
+        url.search
+      ) {
+        return new Response(null, {
+          status: 404,
+          headers: { "cache-control": "no-store" },
+        });
+      }
+      if (
+        !configuration.trustedOrigins.includes(request.headers.get("origin"))
+      ) {
+        return new Response(null, {
+          status: 403,
+          headers: { "cache-control": "no-store" },
+        });
+      }
+      const response = await auth.handler(request);
+      if (!response.ok) {
+        // Stable errors do not echo provider account, session, email or token data.
+        return Response.json(
+          { error: "Authentication failed" },
+          { status: response.status, headers: { "cache-control": "no-store" } },
+        );
+      }
+      // Keep signed HttpOnly cookies while removing Better Auth's JSON bearer.
+      const headers = new Headers(response.headers);
+      headers.delete("content-length");
+      headers.set("content-type", "application/json");
+      headers.set("cache-control", "no-store");
+      return new Response(JSON.stringify({ success: true }), {
+        status: response.status,
+        headers,
+      });
+    },
+  });
+}
