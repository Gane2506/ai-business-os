index 0000000..052c2c0
--- /dev/null
+++ b/packages/services/src/services/email.service.ts
@@ -0,0 +1,262 @@
+import { Injectable } from "@nestjs/common";
+import { createHash, randomBytes, randomUUID } from "node:crypto";
+import { apiConfiguration } from "@ringee/configuration";
+import {
+  EmailRepository,
+  EmailPreferenceCategory,
+  EmailStream,
+} from "@ringee/database";
+import {
+  OwnershipContext,
+  SesProvider,
+  SesEmailRequest,
+  EMAIL_STREAMS,
+  emailStreamIdentity,
+  normalizeEmailAddress,
+  normalizeEmailRootDomain,
+  EmailSendRejectedError,
+  EmailSendUncertainError,
+} from "@ringee/platform";
+
+export interface SendEmailInput {
+  stream: EmailStream;
+  from?: string;
+  fromName?: string;
+  to: string | string[];
+  cc?: string | string[];
+  bcc?: string | string[];
+  replyTo?: string;
+  subject: string;
+  html?: string;
+  text?: string;
+  /** Stable business event identifier, never a recipient-supplied tenant ID. */
+  operationKey?: string;
+  /** Local template identification; templates are rendered by their current owner. */
+  template?: string;
+  metadata?: Record<string, string>;
+  preferenceCategory?: EmailPreferenceCategory;
+}
+
+type Domain = NonNullable<
+  Awaited<ReturnType<EmailRepository["findPlatformDomain"]>>
+>;
+
+/** One policy boundary for every backend sender. The AWS adapter owns transport only. */
+@Injectable()
+export class EmailService {
+  private readonly provider = new SesProvider();
+  constructor(private readonly repository: EmailRepository) {}
+
+  /** Domain enrollment never enables sending or claims verification succeeded. */
+  registerDomain(ctx: OwnershipContext, rootDomain: string): Promise<Domain> {
+    const root = normalizeEmailRootDomain(rootDomain);
+    return this.repository.createDomain(ctx, {
+      rootDomain: root,
+      region: apiConfiguration.AWS_SES_REGION,
+      identities: Object.entries(EMAIL_STREAMS).map(([stream, config]) => ({
+        stream: stream as EmailStream,
+        identityDomain: emailStreamIdentity(root, stream as EmailStream),
+        configurationSet: config.configurationSet,
+      })),
+    });
+  }
+
+  async sendEmail(
+    ctx: OwnershipContext,
+    input: SendEmailInput & { domainId: string },
+  ) {
+    const domain = await this.repository.findDomainForOwner(
+      ctx,
+      input.domainId,
+    );
+    if (!domain) throw new EmailSendRejectedError("DOMAIN_NOT_AUTHORIZED");
+    return this.sendFromDomain(domain, input);
+  }
+
+  /** Internal only: account/security and platform notifications are sent by the
+   * platform itself, including before a visitor has a user or organization. */
+  async sendPlatformEmail(
+    stream: EmailStream,
+    input: Omit<SendEmailInput, "stream">,
+  ) {
+    if (!apiConfiguration.EMAIL_SEND_ENABLED)
+      throw new EmailSendRejectedError("SENDING_DISABLED");
+    const id = apiConfiguration.EMAIL_PLATFORM_DOMAIN_ID;
+    if (!id) throw new EmailSendRejectedError("PLATFORM_DOMAIN_NOT_CONFIGURED");
+    const domain = await this.repository.findPlatformDomain(id);
+    if (!domain)
+      throw new EmailSendRejectedError("PLATFORM_DOMAIN_NOT_CONFIGURED");
+    return this.sendFromDomain(domain, { ...input, stream });
+  }
+
+  private async sendFromDomain(
+    domain: Domain,
+    input: SendEmailInput,
+  ): Promise<{ data: { id: string }; sent: boolean }> {
+    if (!apiConfiguration.EMAIL_SEND_ENABLED)
+      throw new EmailSendRejectedError("SENDING_DISABLED");
+    if (!domain.enabled || domain.region !== apiConfiguration.AWS_SES_REGION)
+      throw new EmailSendRejectedError("DOMAIN_DISABLED_OR_REGION_MISMATCH");
+    if (!apiConfiguration.EMAIL_SNS_TOPIC_ARN)
+      throw new EmailSendRejectedError("FEEDBACK_NOT_CONFIGURED");
+    if (input.stream === "OUTREACH" && !domain.outreachEnabled)
+      throw new EmailSendRejectedError("OUTREACH_DISABLED");
+    const expected = emailStreamIdentity(domain.rootDomain, input.stream);
+    const identity = domain.identities.find(
+      (item) => item.stream === input.stream,
+    );
+    if (
+      !identity?.enabled ||
+      identity.identityDomain !== expected ||
+      identity.configurationSet !== EMAIL_STREAMS[input.stream].configurationSet
+    ) {
+      throw new EmailSendRejectedError("STREAM_NOT_AUTHORIZED");
+    }
+    const from = `noreply@${expected}`;
+    if (input.from && normalizeEmailAddress(input.from) !== from)
+      throw new EmailSendRejectedError("UNAUTHORIZED_FROM");
+    const list = (value?: string | string[]) =>
+      value === undefined
+        ? []
+        : (Array.isArray(value) ? value : [value]).map(normalizeEmailAddress);
+    const to = list(input.to),
+      cc = list(input.cc),
+      bcc = list(input.bcc);
+    const recipients = [...to, ...cc, ...bcc];
+    if (!to.length || recipients.length > 50)
+      throw new EmailSendRejectedError("RECIPIENT_COUNT");
+    if (await this.repository.findSuppression(recipients))
+      throw new EmailSendRejectedError("RECIPIENT_SUPPRESSED");
+    const category =
+      input.stream === "MARKETING"
+        ? "MARKETING"
+        : input.stream === "PROMOTIONAL"
+          ? "PROMOTIONAL"
+          : input.preferenceCategory;
+    if (
+      input.preferenceCategory &&
+      (input.stream === "AUTH" ||
+        input.stream === "TRANSACTIONAL" ||
+        input.stream === "OUTREACH")
+    ) {
+      throw new EmailSendRejectedError("PREFERENCE_NOT_APPLICABLE");
+    }
+    if (
+      category &&
+      (await this.repository.findPreference(domain.id, recipients, category))
+    )
+      throw new EmailSendRejectedError("RECIPIENT_UNSUBSCRIBED");
+    // A preference link authorizes exactly one recipient and one category.
+    if (category && (to.length !== 1 || cc.length || bcc.length))
+      throw new EmailSendRejectedError(
+        "OPTIONAL_EMAIL_REQUIRES_SINGLE_RECIPIENT",
+      );
+    const status = await this.provider.getIdentityStatus(
+      domain.rootDomain,
+      input.stream,
+    );
+    await this.repository.updateIdentityStatus(domain.id, input.stream, {
+      verificationStatus: status.verificationStatus,
+      dkimStatus: status.dkimStatus,
+      mailFromStatus: status.mailFromStatus,
+    });
+    if (!status.ready) throw new EmailSendRejectedError("IDENTITY_NOT_READY");
+    const fingerprint = createHash("sha256")
+      .update(
+        JSON.stringify({
+          domainId: domain.id,
+          stream: input.stream,
+          from,
+          to: [...to].sort(),
+          cc: [...cc].sort(),
+          bcc: [...bcc].sort(),
+          replyTo: input.replyTo,
+          subject: input.subject,
+          html: input.html,
+          text: input.text,
+          category,
+        }),
+      )
+      .digest("hex");
+    const operationKey = input.operationKey
+      ? `${domain.id}:${input.operationKey}`
+      : randomUUID();
+    const { delivery, claimed } = await this.repository.beginDelivery({
+      domainId: domain.id,
+      stream: input.stream,
+      operationKey,
+      fingerprint,
+      recipients,
+    });
+    if (!claimed) {
+      if (delivery.fingerprint !== fingerprint)
+        throw new EmailSendRejectedError("OPERATION_KEY_REUSED");
+      if (delivery.status === "ACCEPTED" && delivery.messageId)
+        return { data: { id: delivery.messageId }, sent: true as const };
+      throw new EmailSendUncertainError();
+    }
+    let sendStarted = false;
+    try {
+      let html = input.html,
+        text = input.text,
+        unsubscribeUrl: string | undefined;
+      if (category) {
+        const base = apiConfiguration.EMAIL_UNSUBSCRIBE_BASE_URL;
+        if (!base || !/^https:\/\//.test(base))
+          throw new EmailSendRejectedError("UNSUBSCRIBE_NOT_CONFIGURED");
+        const token = randomBytes(32).toString("hex");
+        await this.repository.createUnsubscribeToken({
+          tokenHash: createHash("sha256").update(token).digest("hex"),
+          domainId: domain.id,
+          email: to[0],
+          category,
+        });
+        const url = new URL(base);
+        url.pathname = `${url.pathname.replace(/\/$/, "")}/${token}`;
+        unsubscribeUrl = url.toString();
+        if (html)
+          html += `<p><a href="${unsubscribeUrl.replace(/&/g, "&amp;").replace(/"/g, "&quot;")}">Unsubscribe from these emails</a></p>`;
+        if (text)
+          text += `\n\nUnsubscribe from these emails: ${unsubscribeUrl}`;
+      }
+      const request: SesEmailRequest = {
+        rootDomain: domain.rootDomain,
+        stream: input.stream,
+        from,
+        fromName: input.fromName,
+        to,
+        cc,
+        bcc,
+        replyTo: input.replyTo,
+        subject: input.subject,
+        html,
+        text,
+        unsubscribeUrl,
+        tags: {
+          ...input.metadata,
+          emailDomainId: domain.id,
+          stream: input.stream,
+          deliveryId: delivery.id,
+        },
+      };
+      sendStarted = true;
+      const result = await this.provider.sendEmail(request);
+      // If persistence fails after acceptance, leave SENDING/UNKNOWN to prevent
+      // replay. Operator reconciliation can use SNS MessageId and deliveryId.
+      await this.repository.finishDelivery(
+        delivery.id,
+        "ACCEPTED",
+        result.data.id,
+      );
+      return result;
+    } catch (error) {
+      const uncertain =
+        sendStarted && !(error instanceof EmailSendRejectedError);
+      await this.repository
+        .finishDelivery(delivery.id, uncertain ? "UNKNOWN" : "REJECTED")
+        .catch(() => undefined);
+      if (uncertain) throw new EmailSendUncertainError();
+      throw error;
+    }
+  }
+}
