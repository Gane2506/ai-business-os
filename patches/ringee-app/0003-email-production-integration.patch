@@ -0,0 +1,79 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+const config = vi.hoisted(() => ({
+  EMAIL_MAUTIC_FEEDBACK_URL: "https://marketing.example.com/mailer/callback",
+  EMAIL_MAUTIC_ROOT_DOMAIN: "example.com",
+  EMAIL_MAUTIC_FEEDBACK_SECRET: "offline-test-secret-32-characters-or-longer",
+}));
+vi.mock("@ringee/configuration", () => ({ apiConfiguration: config }));
+import { MauticFeedbackClient } from "./mautic-feedback.client";
+import { createHmac } from "node:crypto";
+import { EmailFeedback } from "./ses-feedback";
+
+const feedback: EmailFeedback = {
+  eventId: "event-1",
+  providerMessageId: "message-1",
+  type: "Complaint",
+  occurredAt: new Date(),
+  identityDomain: "news.example.com",
+  configurationSet: "ses-marketing",
+  recipients: ["person@example.com"],
+  suppressionReason: "COMPLAINT",
+};
+afterEach(() => {
+  vi.unstubAllGlobals();
+  config.EMAIL_MAUTIC_FEEDBACK_URL =
+    "https://marketing.example.com/mailer/callback";
+});
+describe("Mautic native DNC sync (offline)", () => {
+  it("signs minimal bytes and timestamp, disables redirects and checks receiver success", async () => {
+    const fetch = vi
+      .fn()
+      .mockResolvedValue({ ok: true, body: { cancel: vi.fn() } });
+    vi.stubGlobal("fetch", fetch);
+    await new MauticFeedbackClient().sync("example.com", feedback);
+    const [url, request] = fetch.mock.calls[0];
+    expect(url.href).toBe(config.EMAIL_MAUTIC_FEEDBACK_URL);
+    expect(request.redirect).toBe("error");
+    expect(request.headers["X-Ai-Os-Signature"]).toBe(
+      createHmac("sha256", config.EMAIL_MAUTIC_FEEDBACK_SECRET)
+        .update(`${request.headers["X-Ai-Os-Timestamp"]}.${request.body}`)
+        .digest("hex"),
+    );
+    expect(JSON.parse(request.body)).toEqual({
+      eventId: "event-1",
+      type: "Complaint",
+      reason: "COMPLAINT",
+      recipients: ["person@example.com"],
+      identityDomain: "news.example.com",
+    });
+  });
+  it("fails closed on another tenant or untrusted endpoint before network", async () => {
+    const fetch = vi.fn();
+    vi.stubGlobal("fetch", fetch);
+    config.EMAIL_MAUTIC_FEEDBACK_URL = "https://evil.test/mailer/callback";
+    await expect(
+      new MauticFeedbackClient().sync("example.com", feedback),
+    ).rejects.toThrow("endpoint");
+    expect(fetch).not.toHaveBeenCalled();
+  });
+  it("does not forward transient bounces or authentication events", async () => {
+    const fetch = vi.fn();
+    vi.stubGlobal("fetch", fetch);
+    const client = new MauticFeedbackClient();
+    await client.sync("example.com", {
+      ...feedback,
+      suppressionReason: undefined,
+    });
+    await client.sync("example.com", {
+      ...feedback,
+      identityDomain: "auth.example.com",
+    });
+    expect(fetch).not.toHaveBeenCalled();
+  });
+  it("surfaces failure for SNS retry rather than reporting a completed DNC sync", async () => {
+    vi.stubGlobal("fetch", vi.fn().mockResolvedValue({ ok: false }));
+    await expect(
+      new MauticFeedbackClient().sync("example.com", feedback),
+    ).rejects.toThrow("failed");
+  });
+});
diff --git a/packages/platform/src/email/mautic-feedback.client.ts b/packages/platform/src/email/mautic-feedback.client.ts
new file mode 100644
index 0000000..339e93c
--- /dev/null
+++ b/packages/platform/src/email/mautic-feedback.client.ts
@@ -0,0 +1,60 @@
+import { Injectable } from "@nestjs/common";
+import { createHmac } from "node:crypto";
+import { apiConfiguration } from "@ringee/configuration";
+import { EmailFeedback } from "./ses-feedback";
+
+@Injectable()
+export class MauticFeedbackClient {
+  async sync(rootDomain: string, feedback: EmailFeedback): Promise<void> {
+    if (
+      !feedback.suppressionReason ||
+      !["news.", "offers."].some(
+        (prefix) => feedback.identityDomain === `${prefix}${rootDomain}`,
+      )
+    )
+      return;
+    const endpoint = apiConfiguration.EMAIL_MAUTIC_FEEDBACK_URL;
+    if (!endpoint) return;
+    if (apiConfiguration.EMAIL_MAUTIC_ROOT_DOMAIN !== rootDomain)
+      throw new Error("Mautic tenant is not authorized");
+    const url = new URL(endpoint);
+    if (
+      url.protocol !== "https:" ||
+      url.hostname !== `marketing.${rootDomain}` ||
+      url.pathname !== "/mailer/callback" ||
+      url.port ||
+      url.username ||
+      url.password ||
+      url.search ||
+      url.hash
+    )
+      throw new Error("Invalid Mautic feedback endpoint");
+    const secret = apiConfiguration.EMAIL_MAUTIC_FEEDBACK_SECRET;
+    if (!secret || secret.length < 32)
+      throw new Error("Mautic feedback secret is not configured");
+    const payload = JSON.stringify({
+      eventId: feedback.eventId,
+      type: feedback.type,
+      reason: feedback.suppressionReason,
+      recipients: feedback.recipients,
+      identityDomain: feedback.identityDomain,
+    });
+    const timestamp = Math.floor(Date.now() / 1000).toString();
+    const signature = createHmac("sha256", secret)
+      .update(`${timestamp}.${payload}`)
+      .digest("hex");
+    const response = await fetch(url, {
+      method: "POST",
+      redirect: "error",
+      signal: AbortSignal.timeout(5000),
+      headers: {
+        "Content-Type": "application/json",
+        "X-Ai-Os-Timestamp": timestamp,
+        "X-Ai-Os-Signature": signature,
+      },
+      body: payload,
+    });
+    if (!response.ok) throw new Error("Mautic feedback synchronization failed");
+    await response.body?.cancel();
+  }
+}
