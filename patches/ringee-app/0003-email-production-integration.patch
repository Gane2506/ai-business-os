+/// <reference types="node" />
+
+import "reflect-metadata";
+
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { Logger } from "@nestjs/common";
+import { UserAccessEnforcementService } from "./user-access-enforcement.service";
+
+function build(
+  over: {
+    user?: {
+      id: string;
+      blockedAt: Date | null;
+      blockedReason: string | null;
+      canCall: boolean;
+    } | null;
+  } = {},
+) {
+  const revoked: string[] = [];
+  const blocked: Array<{ userId: string; reason: string }> = [];
+  const unblocked: Array<{ userId: string; reason: string }> = [];
+  const terminated: string[] = [];
+  const restored: string[] = [];
+
+  const user =
+    over.user !== undefined
+      ? over.user
+      : { id: "user-1", blockedAt: null, blockedReason: null, canCall: true };
+
+  const userRepository = {
+    findById: async () => user,
+    update: async (id: string, data: Record<string, unknown>) =>
+      Object.assign({}, user, data),
+  };
+  const userService = {
+    blockAccount: async (userId: string, reason: string) => {
+      blocked.push({ userId, reason });
+      return { id: userId };
+    },
+    unblockAccount: async (userId: string, expectedReason: string) => {
+      unblocked.push({ userId, reason: expectedReason });
+      return { id: userId };
+    },
+    invalidateUserCache: async () => undefined,
+  };
+  const identities = {
+    revokeIdentitySessions: async (userId: string) => {
+      revoked.push(userId);
+      return 2;
+    },
+  };
+  const callTermination = {
+    terminateAllForUser: async (userId: string) => {
+      terminated.push(userId);
+      return { callIds: [], terminated: 0, withoutControlId: 0, failed: 0 };
+    },
+  };
+  const realtimeEvents = {
+    accountBlocked: async () => undefined,
+    accountRestored: async (userId: string) => {
+      restored.push(userId);
+    },
+    callsTerminated: async () => undefined,
+  };
+  const presence = { list: async () => [] };
+  const agentSessionService = { disableForUser: async () => 0 };
+  const redis = { delMany: async () => undefined };
+
+  const service = new UserAccessEnforcementService(
+    userRepository as never,
+    userService as never,
+    identities as never,
+    agentSessionService as never,
+    redis as never,
+    callTermination as never,
+    realtimeEvents as never,
+    presence as never,
+  );
+  Object.assign(service, {
+    logger: Object.assign(new Logger("spec"), {
+      log: () => {},
+      warn: () => {},
+      error: () => {},
+    }),
+  });
+
+  return { service, revoked, blocked, unblocked, terminated, restored };
+}
+
+describe("UserAccessEnforcementService.setIdentityBan", () => {
+  it("revokes sessions, blocks and locks down a fresh account", async () => {
+    const { service, revoked, blocked, terminated } = build();
+
+    const { access, enforcement } = await service.setIdentityBan("user-1", true);
+
+    assert.deepEqual(revoked, ["user-1"]);
+    assert.deepEqual(blocked, [
+      { userId: "user-1", reason: "identity_banned" },
+    ]);
+    assert.deepEqual(terminated, ["user-1"]);
+    assert.equal(enforcement.devicesNotified, 0);
+    assert.equal(access.ringeeBlocked, false); // mock user row is unchanged
+  });
+
+  it("preserves a pre-existing block reason and still locks down", async () => {
+    const { service, revoked, blocked, terminated } = build({
+      user: {
+        id: "user-1",
+        blockedAt: new Date(),
+        blockedReason: "stripe_payment_abuse",
+        canCall: false,
+      },
+    });
+
+    await service.setIdentityBan("user-1", true);
+
+    assert.deepEqual(revoked, ["user-1"]);
+    assert.deepEqual(blocked, []); // reason preserved, not overwritten
+    assert.deepEqual(terminated, ["user-1"]);
+  });
+
+  it("restores only a block the identity flow owns", async () => {
+    const { service, unblocked, restored } = build({
+      user: {
+        id: "user-1",
+        blockedAt: new Date(),
+        blockedReason: "identity_banned",
+        canCall: false,
+      },
+    });
+
+    const { access } = await service.setIdentityBan("user-1", false);
+
+    assert.deepEqual(unblocked, [
+      { userId: "user-1", reason: "identity_banned" },
+    ]);
+    assert.deepEqual(restored, ["user-1"]);
+    assert.equal(access.identityBanned, true); // mock row still carries it
+  });
+
+  it("restores a legacy provider-ban reason too", async () => {
+    const { service, unblocked } = build({
+      user: {
+        id: "user-1",
+        blockedAt: new Date(),
+        blockedReason: "clerk_user_banned",
+        canCall: false,
+      },
+    });
+
+    await service.setIdentityBan("user-1", false);
+
+    assert.deepEqual(unblocked, [
+      { userId: "user-1", reason: "clerk_user_banned" },
+    ]);
+  });
+
+  it("never clears an unrelated enforcement on unban", async () => {
+    const { service, unblocked, restored } = build({
+      user: {
+        id: "user-1",
+        blockedAt: new Date(),
+        blockedReason: "manual_review",
+        canCall: false,
+      },
+    });
+
+    await service.setIdentityBan("user-1", false);
+
+    assert.deepEqual(unblocked, []);
+    assert.deepEqual(restored, []);
+  });
+});
+
+describe("UserAccessEnforcementService.getAdminState", () => {
+  it("reports the identity ban from the block reason", async () => {
+    const { service } = build({
+      user: {
+        id: "user-1",
+        blockedAt: new Date(),
+        blockedReason: "identity_banned",
+        canCall: false,
+      },
+    });
+    const state = await service.getAdminState("user-1");
+    assert.equal(state.ringeeBlocked, true);
+    assert.equal(state.identityBanned, true);
+    assert.equal(state.canCall, false);
+  });
+
+  it("does not report a product block as an identity ban", async () => {
+    const { service } = build({
+      user: {
+        id: "user-1",
+        blockedAt: new Date(),
+        blockedReason: "stripe_payment_abuse",
+        canCall: false,
+      },
+    });
+    const state = await service.getAdminState("user-1");
+    assert.equal(state.ringeeBlocked, true);
+    assert.equal(state.identityBanned, false);
+  });
+});
