@@ -0,0 +1,58 @@
+"use client";
+
+import { createAuthClient } from "better-auth/react";
+import { ApiClient, ApiError } from "../lib/api";
+import { readAuthPrincipal } from "./contracts";
+
+export interface EmailPasswordCredentials {
+  email: string;
+  password: string;
+}
+
+export function createRingeeAuthClient(apiBaseURL: string) {
+  const apiURL = new URL(apiBaseURL);
+  const loopback = ["localhost", "127.0.0.1", "[::1]"].includes(
+    apiURL.hostname,
+  );
+  if (
+    (apiURL.protocol !== "https:" &&
+      !(apiURL.protocol === "http:" && loopback)) ||
+    apiURL.search ||
+    apiURL.hash ||
+    apiURL.username ||
+    apiURL.password ||
+    apiURL.pathname.replace(/\/$/, "") !== "/api"
+  ) {
+    throw new Error("Invalid authentication API URL");
+  }
+  const apiPath = apiURL.pathname.replace(/\/$/, "");
+  const provider = createAuthClient({
+    baseURL: apiURL.origin,
+    basePath: `${apiPath}/auth`,
+    fetchOptions: { credentials: "include" },
+  });
+  const api = new ApiClient({
+    baseURL: apiBaseURL.replace(/\/$/, ""),
+    cache: "no-store",
+  });
+
+  return {
+    getPrincipal: () => readAuthPrincipal(api),
+    async signIn(credentials: EmailPasswordCredentials) {
+      // No provider token or user object escapes this browser-only adapter.
+      const result = await provider.signIn.email(credentials);
+      if (result.error) {
+        throw new ApiError("Sign in failed", result.error.status);
+      }
+      const principal = await readAuthPrincipal(api);
+      if (!principal) throw new ApiError("Authentication required", 401);
+      return principal;
+    },
+    async signOut() {
+      const result = await provider.signOut();
+      if (result.error) {
+        throw new ApiError("Sign out failed", result.error.status);
+      }
+    },
+  };
+}
