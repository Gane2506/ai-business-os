diff --git a/packages/services/src/services/auth-identity.service.spec.ts b/packages/services/src/services/auth-identity.service.spec.ts
new file mode 100644
index 0000000..d0f778b
--- /dev/null
+++ b/packages/services/src/services/auth-identity.service.spec.ts
@@ -0,0 +1,204 @@
+/// <reference types="node" />
+
+import "reflect-metadata";
+
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { DuplicateAuthEmailError } from "@ringee/database";
+import {
+  AuthIdentityError,
+  AuthIdentityService,
+} from "./auth-identity.service";
+
+interface CreatedInput {
+  email: string;
+  firstName: string;
+  lastName: string;
+  passwordHash: string;
+}
+
+/** The persistence layer, in memory. */
+function build(
+  over: {
+    authEmailTaken?: boolean;
+    findByAuthEmail?: { id: string } | null;
+    credentialAccounts?: number;
+  } = {},
+) {
+  const created: CreatedInput[] = [];
+  const passwordUpdates: Array<{ userId: string; passwordHash: string }> = [];
+  let revokedFor: string | null = null;
+
+  const users = {
+    findByAuthEmail: async (email: string) => {
+      if (over.findByAuthEmail !== undefined) return over.findByAuthEmail;
+      return null;
+    },
+    createEnrolledIdentity: async (input: CreatedInput) => {
+      if (over.authEmailTaken) throw new DuplicateAuthEmailError(input.email);
+      created.push(input);
+      return { id: "user-1" };
+    },
+    setCredentialPassword: async (userId: string, passwordHash: string) => {
+      passwordUpdates.push({ userId, passwordHash });
+      return over.credentialAccounts ?? 1;
+    },
+  };
+  const sessions = {
+    revokeAllForUser: async (userId: string) => {
+      revokedFor = userId;
+      return 3;
+    },
+  };
+
+  const service = new AuthIdentityService(users as never, sessions as never);
+  const revoked = () => revokedFor;
+  return { service, created, passwordUpdates, revoked };
+}
+
+describe("AuthIdentityService.createIdentity", () => {
+  it("normalizes the email and stores a hash, never the password", async () => {
+    const { service, created } = build();
+
+    const ref = await service.createIdentity({
+      email: "  Ada@Example.COM ",
+      firstName: "Ada",
+      lastName: "Lovelace",
+      password: "correct-horse-123",
+    });
+
+    assert.deepEqual(ref, { id: "user-1" });
+    assert.equal(created.length, 1);
+    assert.equal(created[0].email, "ada@example.com");
+    assert.equal(created[0].firstName, "Ada");
+    assert.equal(created[0].lastName, "Lovelace");
+    assert.notEqual(created[0].passwordHash, "correct-horse-123");
+    assert.ok(created[0].passwordHash.length > 32);
+  });
+
+  it("rejects a malformed email", async () => {
+    const { service } = build();
+    await assert.rejects(
+      service.createIdentity({
+        email: "not-an-email",
+        firstName: "Ada",
+        lastName: "Lovelace",
+        password: "correct-horse-123",
+      }),
+      (error: unknown) =>
+        error instanceof AuthIdentityError && error.reason === "invalid_email",
+    );
+  });
+
+  it("rejects an empty name", async () => {
+    const { service } = build();
+    await assert.rejects(
+      service.createIdentity({
+        email: "ada@example.com",
+        firstName: "  ",
+        lastName: "Lovelace",
+        password: "correct-horse-123",
+      }),
+      (error: unknown) =>
+        error instanceof AuthIdentityError && error.reason === "invalid_name",
+    );
+  });
+
+  it("rejects a password below the policy", async () => {
+    const { service, created } = build();
+    await assert.rejects(
+      service.createIdentity({
+        email: "ada@example.com",
+        firstName: "Ada",
+        lastName: "Lovelace",
+        password: "short",
+      }),
+      (error: unknown) =>
+        error instanceof AuthIdentityError &&
+        error.reason === "password_rejected",
+    );
+    assert.deepEqual(created, []);
+  });
+
+  it("maps an enrolled email to email_taken", async () => {
+    const { service } = build({ authEmailTaken: true });
+    await assert.rejects(
+      service.createIdentity({
+        email: "ada@example.com",
+        firstName: "Ada",
+        lastName: "Lovelace",
+        password: "correct-horse-123",
+      }),
+      (error: unknown) =>
+        error instanceof AuthIdentityError && error.reason === "email_taken",
+    );
+  });
+});
+
+describe("AuthIdentityService.findIdentityByEmail", () => {
+  it("normalizes before lookup and returns the id", async () => {
+    const seen: string[] = [];
+    const users = {
+      findByAuthEmail: async (email: string) => {
+        seen.push(email);
+        return { id: "user-9" };
+      },
+    };
+    const service = new AuthIdentityService(users as never, {} as never);
+
+    assert.deepEqual(await service.findIdentityByEmail(" Ada@Example.COM "), {
+      id: "user-9",
+    });
+    assert.deepEqual(seen, ["ada@example.com"]);
+  });
+
+  it("returns null when no identity owns the email", async () => {
+    const { service } = build();
+    assert.equal(await service.findIdentityByEmail("nobody@example.com"), null);
+  });
+});
+
+describe("AuthIdentityService.setIdentityPassword", () => {
+  it("hashes, stores and revokes other sessions", async () => {
+    const { service, passwordUpdates, revoked } = build();
+
+    await service.setIdentityPassword("user-1", "new-password-123");
+
+    assert.equal(passwordUpdates.length, 1);
+    assert.equal(passwordUpdates[0].userId, "user-1");
+    assert.notEqual(passwordUpdates[0].passwordHash, "new-password-123");
+    assert.equal(revoked(), "user-1");
+  });
+
+  it("fails closed when the user has no credential identity", async () => {
+    const { service, passwordUpdates } = build({ credentialAccounts: 0 });
+    await assert.rejects(
+      service.setIdentityPassword("user-1", "new-password-123"),
+      (error: unknown) =>
+        error instanceof AuthIdentityError &&
+        error.reason === "no_credential",
+    );
+    // The hash was computed but nothing was stored and no sessions touched.
+    assert.equal(passwordUpdates.length, 1);
+  });
+
+  it("rejects a password below the policy before touching storage", async () => {
+    const { service, passwordUpdates, revoked } = build();
+    await assert.rejects(
+      service.setIdentityPassword("user-1", "short"),
+      (error: unknown) =>
+        error instanceof AuthIdentityError &&
+        error.reason === "password_rejected",
+    );
+    assert.deepEqual(passwordUpdates, []);
+    assert.equal(revoked(), null);
+  });
+});
+
+describe("AuthIdentityService.revokeIdentitySessions", () => {
+  it("delegates to the session store", async () => {
+    const { service, revoked } = build();
+    assert.equal(await service.revokeIdentitySessions("user-1"), 3);
+    assert.equal(revoked(), "user-1");
+  });
+});
diff --git a/packages/services/src/services/auth-identity.service.ts b/packages/services/src/services/auth-identity.service.ts
new file mode 100644
index 0000000..3dc415c
--- /dev/null
+++ b/packages/services/src/services/auth-identity.service.ts
@@ -0,0 +1,167 @@
+import { Injectable, Logger } from "@nestjs/common";
+import {
+  AuthSessionRepository,
+  DuplicateAuthEmailError,
+  UserRepository,
+} from "@ringee/database";
+import { hashCredentialPassword, NewsletterService } from "@ringee/platform";
+
+/** Why an auth identity operation was refused. */
+export type AuthIdentityFailure =
+  | "email_taken"
+  | "invalid_email"
+  | "invalid_name"
+  | "password_rejected"
+  | "no_credential"
+  | "unknown";
+
+export class AuthIdentityError extends Error {
+  constructor(
+    readonly reason: AuthIdentityFailure,
+    message: string,
+  ) {
+    super(message);
+    this.name = "AuthIdentityError";
+  }
+}
+
+export interface NewAuthIdentity {
+  email: string;
+  firstName: string;
+  lastName: string;
+  password: string;
+}
+
+/** A provisioned login, as the neutral auth identity id (the User UUID). */
+export interface AuthIdentityRef {
+  id: string;
+}
+
+/** Minimum password length, matching the pinned Better Auth default policy. */
+const MIN_PASSWORD_LENGTH = 8;
+
+/**
+ * Provider-neutral auth identity management (LIFE-005).
+ *
+ * This is the seam where the old Clerk-backed provisioning used to live:
+ * creating logins, finding them by email, replacing passwords, and revoking
+ * sessions. The identity itself is Ringee-owned — the User row plus its
+ * credential AuthAccount — so there is no external provider to synchronize
+ * with. Passwords are hashed with the pinned Better Auth scheme (via the
+ * platform primitive), so a password set here verifies through the runtime's
+ * own sign-in path.
+ */
+@Injectable()
+export class AuthIdentityService {
+  private readonly logger = new Logger(AuthIdentityService.name);
+
+  constructor(
+    private readonly users: UserRepository,
+    private readonly sessions: AuthSessionRepository,
+  ) {}
+
+  /** Normalized the way the auth runtime matches emails. */
+  private static normalizeEmail(email: string): string {
+    return email.trim().toLowerCase();
+  }
+
+  private static validEmail(email: string): boolean {
+    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
+  }
+
+  /**
+   * Create a login for a real person. The email must be well-formed and not
+   * already enrolled, the name must be real and nonempty, and the password
+   * must satisfy the policy. Either the identity is fully created (user row,
+   * primary email row, credential account) or nothing is.
+   */
+  async createIdentity(input: NewAuthIdentity): Promise<AuthIdentityRef> {
+    const email = AuthIdentityService.normalizeEmail(input.email);
+    const firstName = input.firstName.trim();
+    const lastName = input.lastName.trim();
+    if (!AuthIdentityService.validEmail(email)) {
+      throw new AuthIdentityError(
+        "invalid_email",
+        `Invalid email address: ${input.email}`,
+      );
+    }
+    if (!firstName || !lastName) {
+      throw new AuthIdentityError(
+        "invalid_name",
+        "First and last name are required.",
+      );
+    }
+    if (input.password.length < MIN_PASSWORD_LENGTH) {
+      throw new AuthIdentityError(
+        "password_rejected",
+        "The password does not satisfy the password policy.",
+      );
+    }
+
+    try {
+      const user = await this.users.createEnrolledIdentity({
+        email,
+        firstName,
+        lastName,
+        passwordHash: await hashCredentialPassword(input.password),
+      });
+      // Best-effort, as before: provisioning never fails on the newsletter.
+      NewsletterService.register(email).catch((error: Error) =>
+        this.logger.warn(`Newsletter registration failed: ${error.message}`),
+      );
+      return { id: user.id };
+    } catch (error) {
+      if (error instanceof DuplicateAuthEmailError) {
+        throw new AuthIdentityError(
+          "email_taken",
+          "An account with this email already exists.",
+        );
+      }
+      throw new AuthIdentityError(
+        "unknown",
+        `Could not create the login: ${(error as Error)?.message ?? error}`,
+      );
+    }
+  }
+
+  /** The enrolled identity owning an email address, if there is one. */
+  async findIdentityByEmail(email: string): Promise<AuthIdentityRef | null> {
+    const user = await this.users.findByAuthEmail(
+      AuthIdentityService.normalizeEmail(email),
+    );
+    return user ? { id: user.id } : null;
+  }
+
+  /**
+   * Replace a login's password and revoke its sessions everywhere else, the
+   * way the old provider did on a password change. Fails closed when the user
+   * has no credential identity rather than pretending a password was set.
+   */
+  async setIdentityPassword(userId: string, password: string): Promise<void> {
+    if (password.length < MIN_PASSWORD_LENGTH) {
+      throw new AuthIdentityError(
+        "password_rejected",
+        "The password does not satisfy the password policy.",
+      );
+    }
+    const updated = await this.users.setCredentialPassword(
+      userId,
+      await hashCredentialPassword(password),
+    );
+    if (updated === 0) {
+      throw new AuthIdentityError(
+        "no_credential",
+        "The user has no credential identity to set a password on.",
+      );
+    }
+    await this.revokeIdentitySessions(userId);
+  }
+
+  /**
+   * Revoke every session for a user. Deleting the rows is the revocation: the
+   * session reader only accepts rows it can find. Returns the count revoked.
+   */
+  async revokeIdentitySessions(userId: string): Promise<number> {
+    return this.sessions.revokeAllForUser(userId);
+  }
+}
