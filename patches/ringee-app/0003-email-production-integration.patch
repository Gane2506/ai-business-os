+    assert.deepEqual(memberships, [ADMIN]);
+  });
+
+  it("adds the membership with a supported role", async () => {
+    const { service, memberships } = build({ memberships: [ADMIN] });
+    await service.addMember("org-1", "user-2", "org:member");
+    assert.deepEqual(memberships, [
+      ADMIN,
+      { organizationId: "org-1", userId: "user-2", role: "org:member" },
+    ]);
+  });
+});
+
+describe("OrganizationService.removeMember", () => {
+  it("refuses to remove the last administrator", async () => {
