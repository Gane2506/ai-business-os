+import OpenAI from "openai";
+import { apiConfiguration } from "@ringee/configuration";
+import { isModelPriced } from "../pricing";
+
+export type TextAiProviderName = "openrouter" | "openai";
+
+/** Build only when a text request is made; other providers need no OpenAI key. */
+export function createTextAiClient(provider: TextAiProviderName): OpenAI {
+  if (provider === "openrouter") {
+    const apiKey = apiConfiguration.OPENROUTER_API_KEY;
+    if (!apiKey) {
+      throw new Error("OPENROUTER_API_KEY is required for OpenRouter text requests");
+    }
+    return new OpenAI({ apiKey, baseURL: "https://openrouter.ai/api/v1" });
+  }
+  const apiKey = apiConfiguration.OPENAI_API_KEY;
+  if (!apiKey) {
+    throw new Error("OPENAI_API_KEY is required for OpenAI text requests");
+  }
+  return new OpenAI({ apiKey });
+}
+
+/** Require a reviewed OpenRouter tariff before any request can incur cost. */
+export function reviewedOpenRouterModel(model: string): string {
+  // Provider pricing can differ even when a model ID resembles a direct API ID.
+  if (model !== "openai/gpt-5.4-mini" || !isModelPriced(model)) {
+    throw new Error(
+      `OpenRouter model ${model} has no reviewed Ringee token pricing; add a reviewed pricing entry before use`,
+    );
+  }
+  return model;
+}
