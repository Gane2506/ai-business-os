+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const config = vi.hoisted(() => ({
+  AWS_SES_REGION: "ca-central-1",
+  EMAIL_FROM_NAME: "Business OS",
+  EMAIL_SEND_ENABLED: true,
+  EMAIL_MAX_SEND_RATE: 1000,
+  EMAIL_VERIFICATION_TTL_MS: 60000,
+}));
+vi.mock("@ringee/configuration", () => ({ apiConfiguration: config }));
+import { SesProvider } from "./ses.provider";
+import { EMAIL_STREAMS, EmailSendUncertainError } from "./email-streams";
+
+function build(
+  options: {
+    identity?: object;
+    account?: object;
+    configSet?: object;
+    sendErrors?: object[];
+    suppressed?: boolean;
+    noId?: boolean;
+  } = {},
+) {
+  const attempts: unknown[] = [];
+  const send = vi.fn(
+    async (command: { constructor: { name: string }; input: unknown }) => {
+      switch (command.constructor.name) {
+        case "GetEmailIdentityCommand":
+          return {
+            VerificationStatus: "SUCCESS",
+            VerifiedForSendingStatus: true,
+            DkimAttributes: { Status: "SUCCESS", SigningEnabled: true },
+            MailFromAttributes: {
+              MailFromDomain: `bounce.${(command.input as { EmailIdentity: string }).EmailIdentity}`,
+              MailFromDomainStatus: "SUCCESS",
+              BehaviorOnMxFailure: "REJECT_MESSAGE",
+            },
+            ConfigurationSetName:
+              EMAIL_STREAMS[
+                Object.keys(EMAIL_STREAMS).find((key) =>
+                  (
+                    command.input as { EmailIdentity: string }
+                  ).EmailIdentity.startsWith(
+                    EMAIL_STREAMS[key as keyof typeof EMAIL_STREAMS].prefix +
+                      ".",
+                  ),
+                ) as keyof typeof EMAIL_STREAMS
+              ].configurationSet,
+            ...options.identity,
+          };
+        case "GetConfigurationSetCommand":
+          return {
+            SendingOptions: { SendingEnabled: true },
+            ...options.configSet,
+          };
+        case "GetSuppressedDestinationCommand":
+          if (options.suppressed) return { SuppressedDestination: {} };
+          throw Object.assign(new Error("not suppressed"), {
+            name: "NotFoundException",
+          });
+        case "GetAccountCommand":
+          return {
+            SendingEnabled: true,
+            ProductionAccessEnabled: true,
+            SendQuota: {
+              Max24HourSend: 10000,
+              SentLast24Hours: 0,
+              MaxSendRate: 1000,
+            },
+            ...options.account,
+          };
+        case "SendEmailCommand": {
+          attempts.push(command.input);
+          const error = options.sendErrors?.shift();
+          if (error) throw error;
+          return options.noId ? {} : { MessageId: "ses-message" };
+        }
+        default:
+          throw new Error("Unexpected mock command");
+      }
+    },
+  );
+  return {
+    provider: new SesProvider({ send } as never, async () => {}),
+    send,
+    attempts,
+  };
+}
+const message = {
+  rootDomain: "example.com",
+  stream: "AUTH" as const,
+  to: "a@example.net",
+  subject: "Subject",
+  html: "<p>Body</p>",
+};
+beforeEach(() => {
+  config.EMAIL_SEND_ENABLED = true;
+});
+
+describe("SES v2 policy and transport", () => {
+  it.each(Object.entries(EMAIL_STREAMS))(
+    "maps %s to its exact noreply subdomain and configuration set",
+    async (stream, expected) => {
+      const { provider, attempts } = build();
+      await expect(
+        provider.sendEmail({
+          ...message,
+          stream: stream as keyof typeof EMAIL_STREAMS,
+        }),
+      ).resolves.toEqual({ data: { id: "ses-message" }, sent: true });
+      expect(attempts[0]).toMatchObject({
+        FromEmailAddress: `"Business OS" <noreply@${expected.prefix}.example.com>`,
+        ConfigurationSetName: expected.configurationSet,
+      });
+    },
+  );
+  it("preserves recipient categories and explicit reply-to", async () => {
+    const { provider, attempts } = build();
+    await provider.sendEmail({
+      ...message,
+      cc: "cc@example.net",
+      bcc: ["bcc@example.net"],
+      replyTo: "support@example.net",
+    });
+    expect(attempts[0]).toMatchObject({
+      ReplyToAddresses: ["support@example.net"],
+      Destination: {
+        ToAddresses: ["a@example.net"],
+        CcAddresses: ["cc@example.net"],
+        BccAddresses: ["bcc@example.net"],
+      },
+    });
+  });
+  it.each([
+    "noreply@example.com",
+    "noreply@news.example.com",
+    "hello@auth.example.com",
+    "noreply@auth.other.com",
+  ])("rejects unauthorized From %s before AWS calls", async (from) => {
+    const { provider, send } = build();
+    await expect(provider.sendEmail({ ...message, from })).rejects.toThrow(
+      "UNAUTHORIZED_FROM",
+    );
+    expect(send).not.toHaveBeenCalled();
+  });
+  it("fails closed while sending disabled", async () => {
+    config.EMAIL_SEND_ENABLED = false;
+    const { provider, send } = build();
+    await expect(provider.sendEmail(message)).rejects.toThrow(
+      "SENDING_DISABLED",
+    );
+    expect(send).not.toHaveBeenCalled();
+  });
+  it.each([
+    { VerificationStatus: "PENDING" },
+    { VerifiedForSendingStatus: false },
+    { DkimAttributes: { SigningEnabled: true, Status: "PENDING" } },
+    { ConfigurationSetName: "wrong" },
+    { MailFromAttributes: { MailFromDomainStatus: "PENDING" } },
+  ])("blocks incomplete identity verification", async (identity) => {
+    const { provider, attempts } = build({ identity });
+    await expect(provider.sendEmail(message)).rejects.toThrow(
+      "IDENTITY_NOT_READY",
+    );
+    expect(attempts).toHaveLength(0);
+  });
+  it.each([
+    { SendingOptions: { SendingEnabled: false } },
+    { DeliveryOptions: { SendingPoolName: "dedicated" } },
+  ])("blocks paused or dedicated configuration sets", async (configSet) => {
+    const { provider, attempts } = build({ configSet });
+    await expect(provider.sendEmail(message)).rejects.toThrow(
+      "IDENTITY_NOT_READY",
+    );
+    expect(attempts).toHaveLength(0);
+  });
+  it.each([
+    [{ SendingEnabled: false }, "ACCOUNT_PAUSED"],
+    [{ ProductionAccessEnabled: false }, "SANDBOX_ACCOUNT"],
+    [
+      { SendQuota: { Max24HourSend: 1, SentLast24Hours: 1, MaxSendRate: 1 } },
+      "DAILY_QUOTA",
+    ],
+  ] as const)("checks account state and quota", async (account, reason) => {
+    const { provider, attempts } = build({ account });
+    await expect(provider.sendEmail(message)).rejects.toThrow(reason);
+    expect(attempts).toHaveLength(0);
+  });
+  it("counts cc and bcc against quota", async () => {
+    const { provider, attempts } = build({
+      account: {
+        SendQuota: { Max24HourSend: 2, SentLast24Hours: 0, MaxSendRate: 1000 },
+      },
+    });
+    await expect(
+      provider.sendEmail({
+        ...message,
+        cc: "b@example.net",
+        bcc: "c@example.net",
+      }),
+    ).rejects.toThrow("DAILY_QUOTA");
+    expect(attempts).toHaveLength(0);
+  });
+  it("blocks SES account suppression before SendEmail", async () => {
+    const { provider, attempts } = build({ suppressed: true });
+    await expect(provider.sendEmail(message)).rejects.toThrow(
+      "RECIPIENT_SUPPRESSED",
+    );
+    expect(attempts).toHaveLength(0);
+  });
+  it("retries only an explicit throttling rejection", async () => {
+    const { provider, attempts } = build({
+      sendErrors: [
+        {
+          name: "TooManyRequestsException",
+          $metadata: { httpStatusCode: 429 },
+        },
+      ],
+    });
+    await provider.sendEmail(message);
+    expect(attempts).toHaveLength(2);
+  });
+  it.each([
+    { name: "TimeoutError" },
+    { name: "InternalFailure", $metadata: { httpStatusCode: 500 } },
+  ])("does not retry ambiguous transport outcomes", async (error) => {
+    const { provider, attempts } = build({ sendErrors: [error] });
+    await expect(provider.sendEmail(message)).rejects.toBeInstanceOf(
+      EmailSendUncertainError,
+    );
+    expect(attempts).toHaveLength(1);
+  });
+  it("treats missing acceptance ID as uncertain", async () => {
+    const { provider } = build({ noId: true });
+    await expect(provider.sendEmail(message)).rejects.toBeInstanceOf(
+      EmailSendUncertainError,
+    );
+  });
+  it("rejects header injection before sending", async () => {
+    const { provider, send } = build();
+    await expect(
+      provider.sendEmail({
+        ...message,
+        subject: "hello\r\nBcc: victim@example.com",
+      }),
+    ).rejects.toThrow("INVALID_HEADER");
+    expect(send).not.toHaveBeenCalled();
+  });
+  it("writes one-click headers and both body formats", async () => {
+    const { provider, attempts } = build();
+    await provider.sendEmail({
+      ...message,
+      text: "Body",
+      unsubscribeUrl: "https://app.example.com/unsubscribe/token",
+    });
+    expect(attempts[0]).toMatchObject({
+      Content: {
+        Simple: {
+          Body: { Text: { Data: "Body" }, Html: { Data: "<p>Body</p>" } },
+          Headers: [
+            {
+              Name: "List-Unsubscribe",
+              Value: "<https://app.example.com/unsubscribe/token>",
+            },
+            {
+              Name: "List-Unsubscribe-Post",
+              Value: "List-Unsubscribe=One-Click",
+            },
+          ],
+        },
+      },
+    });
+  });
+});
diff --git a/packages/platform/src/email/ses.provider.ts b/packages/platform/src/email/ses.provider.ts
new file mode 100644
index 0000000..9377867
--- /dev/null
+++ b/packages/platform/src/email/ses.provider.ts
@@ -0,0 +1,276 @@
+import {
+  SESv2Client,
+  SendEmailCommand,
+  GetAccountCommand,
+  GetEmailIdentityCommand,
+  GetConfigurationSetCommand,
+  GetSuppressedDestinationCommand,
+} from "@aws-sdk/client-sesv2";
+import { apiConfiguration } from "@ringee/configuration";
+import {
+  EMAIL_STREAMS,
+  EmailStreamName,
+  EmailSendUncertainError,
+  emailStreamIdentity,
+  normalizeEmailAddress,
+} from "./email-streams";
+
+export interface SesEmailRequest {
+  rootDomain: string;
+  stream: EmailStreamName;
+  from?: string;
+  fromName?: string;
+  to: string | string[];
+  cc?: string | string[];
+  bcc?: string | string[];
+  replyTo?: string;
+  subject: string;
+  html?: string;
+  text?: string;
+  tags?: Record<string, string>;
+  unsubscribeUrl?: string;
+}
+
+export interface SesIdentityStatus {
+  verificationStatus: string;
+  dkimStatus: string;
+  mailFromStatus: string;
+  ready: boolean;
+}
+
+export class EmailSendRejectedError extends Error {
+  readonly retryable = false;
+  constructor(public readonly code: string) {
+    super(`Email send rejected: ${code}`);
+    this.name = "EmailSendRejectedError";
+  }
+}
+
+/** SES v2 only; no credentials, tenancy persistence, or message bodies are logged. */
+export class SesProvider {
+  name = "aws-ses-v2";
+  private static nextSlot = new Map<string, number>();
+  private readonly readiness = new Map<
+    string,
+    { until: number; status: SesIdentityStatus }
+  >();
+  private quota?: { until: number; maxRate: number; remaining: number };
+
+  constructor(
+    private readonly client: Pick<SESv2Client, "send"> = new SESv2Client({
+      region: apiConfiguration.AWS_SES_REGION,
+      // SendEmail has no idempotency token. SDK retries could duplicate a send
+      // when a connection breaks after SES accepted it.
+      maxAttempts: 1,
+    }),
+    private readonly sleep: (ms: number) => Promise<void> = (ms) =>
+      new Promise((resolve) => setTimeout(resolve, ms)),
+  ) {}
+
+  async getIdentityStatus(
+    rootDomain: string,
+    stream: EmailStreamName,
+  ): Promise<SesIdentityStatus> {
+    const identity = emailStreamIdentity(rootDomain, stream);
+    const cached = this.readiness.get(identity);
+    if (cached && cached.until > Date.now()) return cached.status;
+    const result = await this.client.send(
+      new GetEmailIdentityCommand({ EmailIdentity: identity }),
+    );
+    const config = await this.client.send(
+      new GetConfigurationSetCommand({
+        ConfigurationSetName: EMAIL_STREAMS[stream].configurationSet,
+      }),
+    );
+    const status = {
+      verificationStatus: result.VerificationStatus ?? "UNKNOWN",
+      dkimStatus: result.DkimAttributes?.Status ?? "UNKNOWN",
+      mailFromStatus:
+        result.MailFromAttributes?.MailFromDomainStatus ?? "UNKNOWN",
+      ready:
+        result.VerificationStatus === "SUCCESS" &&
+        config.SendingOptions?.SendingEnabled === true &&
+        !config.DeliveryOptions?.SendingPoolName &&
+        result.VerifiedForSendingStatus === true &&
+        result.DkimAttributes?.SigningEnabled === true &&
+        result.DkimAttributes?.Status === "SUCCESS" &&
+        result.MailFromAttributes?.MailFromDomainStatus === "SUCCESS" &&
+        result.MailFromAttributes?.MailFromDomain === `bounce.${identity}` &&
+        result.MailFromAttributes?.BehaviorOnMxFailure === "REJECT_MESSAGE" &&
+        result.ConfigurationSetName === EMAIL_STREAMS[stream].configurationSet,
+    };
+    this.readiness.set(identity, {
+      until: Date.now() + (apiConfiguration.EMAIL_VERIFICATION_TTL_MS ?? 60000),
+      status,
+    });
+    return status;
+  }
+
+  private async reserveQuota(count: number) {
+    if (!this.quota || this.quota.until <= Date.now()) {
+      const account = await this.client.send(new GetAccountCommand({}));
+      if (!account.SendingEnabled)
+        throw new EmailSendRejectedError("ACCOUNT_PAUSED");
+      if (!account.ProductionAccessEnabled)
+        throw new EmailSendRejectedError("SANDBOX_ACCOUNT");
+      this.quota = {
+        until: Date.now() + 10000,
+        maxRate: account.SendQuota?.MaxSendRate ?? 0,
+        remaining: Math.max(
+          0,
+          (account.SendQuota?.Max24HourSend ?? 0) -
+            (account.SendQuota?.SentLast24Hours ?? 0),
+        ),
+      };
+    }
+    if (this.quota.remaining < count)
+      throw new EmailSendRejectedError("DAILY_QUOTA");
+    const rate = Math.min(
+      this.quota.maxRate,
+      apiConfiguration.EMAIL_MAX_SEND_RATE ?? 1,
+    );
+    if (!(rate > 0)) throw new EmailSendRejectedError("RATE_UNAVAILABLE");
+    const key = apiConfiguration.AWS_SES_REGION;
+    const now = Date.now();
+    const slot = Math.max(now, SesProvider.nextSlot.get(key) ?? now);
+    // A busy backend rejects quickly; callers may schedule a later known-safe
+    // attempt. There is no in-memory backlog or extra worker/queue.
+    if (slot - now > 2000) throw new EmailSendRejectedError("RATE_BUSY");
+    SesProvider.nextSlot.set(key, slot + Math.ceil((count / rate) * 1000));
+    this.quota.remaining -= count;
+    if (slot > now) await this.sleep(slot - now);
+  }
+
+  async sendEmail(input: SesEmailRequest) {
+    if (!apiConfiguration.EMAIL_SEND_ENABLED)
+      throw new EmailSendRejectedError("SENDING_DISABLED");
+    const identity = emailStreamIdentity(input.rootDomain, input.stream);
+    const expectedFrom = `noreply@${identity}`;
+    if (input.from && normalizeEmailAddress(input.from) !== expectedFrom) {
+      throw new EmailSendRejectedError("UNAUTHORIZED_FROM");
+    }
+    const addresses = (value?: string | string[]) =>
+      value === undefined
+        ? []
+        : (Array.isArray(value) ? value : [value]).map(normalizeEmailAddress);
+    const to = addresses(input.to),
+      cc = addresses(input.cc),
+      bcc = addresses(input.bcc);
+    const recipients = [...to, ...cc, ...bcc];
+    if (!to.length || recipients.length > 50)
+      throw new EmailSendRejectedError("RECIPIENT_COUNT");
+    if (!input.html && !input.text)
+      throw new EmailSendRejectedError("EMPTY_BODY");
+    for (const header of [
+      input.fromName,
+      input.subject,
+      input.replyTo,
+      input.unsubscribeUrl,
+    ]) {
+      if (header && /[\r\n]/.test(header))
+        throw new EmailSendRejectedError("INVALID_HEADER");
+    }
+    if (input.unsubscribeUrl && !/^https:\/\//.test(input.unsubscribeUrl)) {
+      throw new EmailSendRejectedError("INVALID_UNSUBSCRIBE_URL");
+    }
+    if (!(await this.getIdentityStatus(input.rootDomain, input.stream)).ready) {
+      throw new EmailSendRejectedError("IDENTITY_NOT_READY");
+    }
+    // SES may accept suppressed recipients without delivering. Fail before
+    // SendEmail so acceptance is not mistaken for an attempted delivery.
+    for (const email of new Set(recipients)) {
+      try {
+        await this.client.send(
+          new GetSuppressedDestinationCommand({ EmailAddress: email }),
+        );
+      } catch (error) {
+        if ((error as { name?: string }).name === "NotFoundException") continue;
+        throw new EmailSendRejectedError("SUPPRESSION_CHECK_UNAVAILABLE");
+      }
+      throw new EmailSendRejectedError("RECIPIENT_SUPPRESSED");
+    }
+    try {
+      await this.reserveQuota(recipients.length);
+    } catch (error) {
+      if (error instanceof EmailSendRejectedError) throw error;
+      throw new EmailSendRejectedError("QUOTA_CHECK_UNAVAILABLE");
+    }
+    const name = input.fromName ?? apiConfiguration.EMAIL_FROM_NAME;
+    const command = new SendEmailCommand({
+      FromEmailAddress: name
+        ? `"${name.replace(/\\/g, "\\\\").replace(/"/g, '\\"')}" <${expectedFrom}>`
+        : expectedFrom,
+      ConfigurationSetName: EMAIL_STREAMS[input.stream].configurationSet,
+      Destination: {
+        ToAddresses: to,
+        ...(cc.length ? { CcAddresses: cc } : {}),
+        ...(bcc.length ? { BccAddresses: bcc } : {}),
+      },
+      ...(input.replyTo
+        ? { ReplyToAddresses: [normalizeEmailAddress(input.replyTo)] }
+        : {}),
+      EmailTags: Object.entries(input.tags ?? {}).map(([Name, Value]) => {
+        if (
+          !/^[a-zA-Z0-9_-]{1,256}$/.test(Name) ||
+          !/^[a-zA-Z0-9_-]{1,256}$/.test(Value)
+        ) {
+          throw new EmailSendRejectedError("INVALID_METADATA");
+        }
+        return { Name, Value };
+      }),
+      Content: {
+        Simple: {
+          Subject: { Charset: "UTF-8", Data: input.subject },
+          Body: {
+            ...(input.html
+              ? { Html: { Charset: "UTF-8", Data: input.html } }
+              : {}),
+            ...(input.text
+              ? { Text: { Charset: "UTF-8", Data: input.text } }
+              : {}),
+          },
+          ...(input.unsubscribeUrl
+            ? {
+                Headers: [
+                  {
+                    Name: "List-Unsubscribe",
+                    Value: `<${input.unsubscribeUrl}>`,
+                  },
+                  {
+                    Name: "List-Unsubscribe-Post",
+                    Value: "List-Unsubscribe=One-Click",
+                  },
+                ],
+              }
+            : {}),
+        },
+      },
+    });
+    for (let attempt = 0; ; attempt++) {
+      try {
+        const result = await this.client.send(command);
+        if (!result.MessageId) throw new EmailSendUncertainError();
+        return { data: { id: result.MessageId }, sent: true as const };
+      } catch (error) {
+        const awsError = error as {
+          name?: string;
+          $metadata?: { httpStatusCode?: number };
+        };
+        // An explicit throttling rejection did not accept the message. Network
+        // errors and server errors may have; never blindly resend them.
+        if (awsError.name === "TooManyRequestsException" && attempt < 2) {
+          await this.sleep(250 * 2 ** attempt);
+          continue;
+        }
+        if (
+          awsError.$metadata?.httpStatusCode &&
+          awsError.$metadata.httpStatusCode >= 400 &&
+          awsError.$metadata.httpStatusCode < 500
+        ) {
+          throw new EmailSendRejectedError(awsError.name ?? "REJECTED");
+        }
+        throw new EmailSendUncertainError();
+      }
+    }
+  }
+}
