diff --git a/packages/platform/src/email/sns-feedback.verifier.ts b/packages/platform/src/email/sns-feedback.verifier.ts
new file mode 100644
index 0000000..fa594a0
--- /dev/null
+++ b/packages/platform/src/email/sns-feedback.verifier.ts
@@ -0,0 +1,243 @@
+import { Injectable } from "@nestjs/common";
+import { X509Certificate, verify as verifySignature } from "node:crypto";
+import { get } from "node:https";
+import { apiConfiguration } from "@ringee/configuration";
+
+export interface SnsEnvelope {
+  Type: "Notification" | "SubscriptionConfirmation" | "UnsubscribeConfirmation";
+  MessageId: string;
+  TopicArn: string;
+  Message: string;
+  Timestamp: string;
+  SignatureVersion: "1" | "2";
+  Signature: string;
+  SigningCertURL: string;
+  Subject?: string;
+  Token?: string;
+  SubscribeURL?: string;
+}
+
+/** HTTPS validates the server's AWS chain. Never follow a message-controlled redirect. */
+export function fetchSnsResource(url: string): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const request = get(url, { timeout: 5000 }, (response) => {
+      if (response.statusCode !== 200) {
+        response.resume();
+        reject(new Error("SNS HTTPS response rejected"));
+        return;
+      }
+      const chunks: Buffer[] = [];
+      let size = 0;
+      response.on("data", (chunk: Buffer) => {
+        size += chunk.length;
+        if (size > 65536) {
+          response.destroy(new Error("SNS HTTPS response too large"));
+          return;
+        }
+        chunks.push(chunk);
+      });
+      response.on("end", () => resolve(Buffer.concat(chunks).toString("utf8")));
+      response.on("error", reject);
+    });
+    request.on("timeout", () =>
+      request.destroy(new Error("SNS HTTPS timeout")),
+    );
+    request.on("error", reject);
+  });
+}
+
+export function snsStringToSign(message: SnsEnvelope): string {
+  const fields =
+    message.Type === "Notification"
+      ? [
+          "Message",
+          "MessageId",
+          ...(message.Subject === undefined ? [] : ["Subject"]),
+          "Timestamp",
+          "TopicArn",
+          "Type",
+        ]
+      : [
+          "Message",
+          "MessageId",
+          "SubscribeURL",
+          "Timestamp",
+          "Token",
+          "TopicArn",
+          "Type",
+        ];
+  return fields
+    .map((field) => `${field}\n${message[field as keyof SnsEnvelope]}\n`)
+    .join("");
+}
+
+/** AWS SNS signs canonical field/value pairs, not the serialized JSON bytes. */
+export class SnsMessageVerifier {
+  private readonly certificates = new Map<string, X509Certificate>();
+  private readonly host: string;
+  readonly accountId: string;
+  readonly region: string;
+
+  constructor(
+    readonly topicArn: string,
+    private readonly maxAgeSeconds = 604800,
+    private readonly fetchResource = fetchSnsResource,
+    private readonly now = () => Date.now(),
+  ) {
+    const match = /^arn:aws:sns:([a-z0-9-]+):(\d{12}):[A-Za-z0-9_-]+$/.exec(
+      topicArn,
+    );
+    if (!match)
+      throw new Error("A fixed standard AWS SNS topic ARN is required");
+    this.region = match[1];
+    this.accountId = match[2];
+    this.host = `sns.${this.region}.amazonaws.com`;
+    if (
+      !Number.isInteger(maxAgeSeconds) ||
+      maxAgeSeconds < 300 ||
+      maxAgeSeconds > 2592000
+    ) {
+      throw new Error(
+        "SNS age tolerance must be between 300 and 2592000 seconds",
+      );
+    }
+  }
+
+  private awsUrl(value: string): URL {
+    const url = new URL(value);
+    if (
+      url.protocol !== "https:" ||
+      url.hostname !== this.host ||
+      url.port ||
+      url.username ||
+      url.password ||
+      url.hash
+    ) {
+      throw new Error("Untrusted SNS URL");
+    }
+    return url;
+  }
+
+  confirmationUrl(message: SnsEnvelope): string {
+    if (
+      message.Type !== "SubscriptionConfirmation" ||
+      !message.Token ||
+      !message.SubscribeURL
+    ) {
+      throw new Error("Invalid SNS confirmation");
+    }
+    const url = this.awsUrl(message.SubscribeURL);
+    const keys = [...url.searchParams.keys()].sort();
+    if (
+      url.pathname !== "/" ||
+      keys.join(",") !== "Action,Token,TopicArn" ||
+      url.searchParams.get("Action") !== "ConfirmSubscription" ||
+      url.searchParams.get("TopicArn") !== this.topicArn ||
+      url.searchParams.get("Token") !== message.Token
+    ) {
+      throw new Error("Untrusted SNS confirmation URL");
+    }
+    return url.href;
+  }
+
+  async verify(raw: Buffer | string): Promise<SnsEnvelope> {
+    if (Buffer.byteLength(raw) > 524288)
+      throw new Error("SNS payload too large");
+    const message = JSON.parse(raw.toString()) as SnsEnvelope;
+    if (
+      !message ||
+      typeof message !== "object" ||
+      message.TopicArn !== this.topicArn ||
+      ![
+        "Notification",
+        "SubscriptionConfirmation",
+        "UnsubscribeConfirmation",
+      ].includes(message.Type) ||
+      !["1", "2"].includes(message.SignatureVersion)
+    )
+      throw new Error("Invalid SNS envelope");
+    const fields = [
+      "Message",
+      "MessageId",
+      "Timestamp",
+      "TopicArn",
+      "Type",
+      "Signature",
+      "SigningCertURL",
+    ];
+    if (message.Type !== "Notification") fields.push("SubscribeURL", "Token");
+    for (const field of fields) {
+      if (
+        typeof message[field as keyof SnsEnvelope] !== "string" ||
+        !message[field as keyof SnsEnvelope]
+      ) {
+        throw new Error("Missing SNS signed field");
+      }
+    }
+    if (message.Subject !== undefined && typeof message.Subject !== "string")
+      throw new Error("Invalid SNS subject");
+    if (!/^[A-Za-z0-9+/]+={0,2}$/.test(message.Signature))
+      throw new Error("Invalid SNS signature encoding");
+    const age = this.now() - Date.parse(message.Timestamp);
+    if (
+      !Number.isFinite(age) ||
+      age < -300000 ||
+      age > this.maxAgeSeconds * 1000
+    )
+      throw new Error("Stale SNS envelope");
+    const url = this.awsUrl(message.SigningCertURL);
+    if (
+      url.search ||
+      !/^\/SimpleNotificationService-[A-Za-z0-9_-]+\.pem$/.test(url.pathname)
+    ) {
+      throw new Error("Untrusted SNS certificate path");
+    }
+    let certificate = this.certificates.get(url.href);
+    if (!certificate || Date.parse(certificate.validTo) <= this.now()) {
+      certificate = new X509Certificate(await this.fetchResource(url.href));
+      if (
+        Date.parse(certificate.validFrom) > this.now() ||
+        Date.parse(certificate.validTo) <= this.now() ||
+        certificate.publicKey.asymmetricKeyType !== "rsa"
+      )
+        throw new Error("Invalid SNS certificate");
+      if (this.certificates.size >= 8) this.certificates.clear();
+      this.certificates.set(url.href, certificate);
+    }
+    if (
+      !verifySignature(
+        message.SignatureVersion === "1" ? "RSA-SHA1" : "RSA-SHA256",
+        Buffer.from(snsStringToSign(message)),
+        certificate.publicKey,
+        Buffer.from(message.Signature, "base64"),
+      )
+    ) {
+      throw new Error("Invalid SNS signature");
+    }
+    if (message.Type === "SubscriptionConfirmation")
+      this.confirmationUrl(message);
+    return message;
+  }
+
+  async confirm(message: SnsEnvelope): Promise<void> {
+    await this.fetchResource(this.confirmationUrl(message));
+  }
+}
+
+@Injectable()
+export class SnsFeedbackVerifier {
+  private verifier?: SnsMessageVerifier;
+  get configured(): SnsMessageVerifier {
+    this.verifier ??= new SnsMessageVerifier(
+      apiConfiguration.EMAIL_SNS_TOPIC_ARN,
+      apiConfiguration.EMAIL_SNS_MAX_AGE_SECONDS,
+    );
+    return this.verifier;
+  }
+  verify(raw: Buffer | string) {
+    return this.configured.verify(raw);
+  }
+  confirm(message: SnsEnvelope) {
+    return this.configured.confirm(message);
+  }
+}
