+          target.includes("operationKey") ||
+          (target.includes("domainId") && target.includes("fingerprint"))
+        )
+      )
+        throw error;
+      // operationKey and SQL pending-fingerprint index arbitrate concurrent sends.
+      const raced = await this.prisma.emailDelivery.findFirst({ where });
+      if (!raced) throw error;
+      return { delivery: raced, claimed: false };
+    }
+  }
+  finishDelivery(
+    id: string,
+    status: "ACCEPTED" | "REJECTED" | "UNKNOWN",
+    messageId?: string,
+  ) {
+    return this.prisma.emailDelivery.update({
+      where: { id },
+      data: { status, ...(messageId ? { messageId } : {}) },
+    });
+  }
+  findDeliveryByMessageId(messageId: string) {
+    return this.prisma.emailDelivery.findUnique({
+      where: { messageId },
+      include: { domain: true },
+    });
+  }
+  findIdentityByDomain(identityDomain: string) {
+    return this.prisma.emailIdentity.findUnique({
+      where: { identityDomain },
+      include: { domain: true },
+    });
+  }
+  async recordFeedbackOnce(input: EmailFeedbackInput): Promise<boolean> {
+    try {
+      await this.prisma.$transaction(async (tx) => {
+        const { suppressions, ...event } = input;
+        await tx.emailEvent.create({ data: event });
+        for (const suppression of suppressions)
+          await tx.emailSuppression.upsert({
+            where: { email: suppression.email },
+            create: suppression,
+            update: suppression,
+          });
+      });
+      return true;
+    } catch (error) {
+      if (
+        error instanceof Prisma.PrismaClientKnownRequestError &&
+        error.code === "P2002" &&
+        Array.isArray(error.meta?.target) &&
+        error.meta.target.includes("eventId")
+      )
+        return false;
+      throw error;
+    }
+  }
+  createUnsubscribeToken(input: {
+    tokenHash: string;
+    domainId: string;
+    email: string;
+    category: EmailPreferenceCategory;
+  }) {
+    return this.prisma.emailUnsubscribeToken.create({ data: input });
+  }
+  findUnsubscribeToken(tokenHash: string) {
+    return this.prisma.emailUnsubscribeToken.findUnique({
+      where: { tokenHash },
+      include: { domain: true },
+    });
+  }
+  async unsubscribeOnce(tokenHash: string): Promise<boolean> {
+    return this.prisma.$transaction(async (tx) => {
+      const token = await tx.emailUnsubscribeToken.findUnique({
+        where: { tokenHash },
+      });
+      if (!token) return false;
+      const { domainId, email, category } = token;
+      await tx.emailPreference.upsert({
+        where: { domainId_email_category: { domainId, email, category } },
+        create: { domainId, email, category, unsubscribedAt: new Date() },
+        update: {},
+      });
+      return true;
+    });
+  }
+}
