+import { hashPassword } from "better-auth/crypto";
+
+/**
+ * The pinned Better Auth password scheme (better-auth 1.7.7), used for
+ * server-side provisioning and password changes.
+ *
+ * Provisioning writes go through this primitive — never a hand-rolled hash —
+ * so a password set here always verifies through the runtime's own
+ * `sign-in/email` path. If the pinned Better Auth release ever changes its
+ * scheme, this module is the single place that must follow it.
+ */
+export async function hashCredentialPassword(
+  password: string,
+): Promise<string> {
+  return hashPassword(password);
+}
