+  const memberships: MembershipRow[] = [...(over.memberships ?? [])];
+  const invitations: InvitationRow[] = [...(over.invitations ?? [])];
+  const usersByAuthEmail = over.usersByAuthEmail ?? {};
+  const usersById = over.usersById ?? {};
+
+  const organizationRepository = {
+    addMembershipByIds: async (
+      organizationId: string,
+      userId: string,
+      role: string,
+    ) => {
+      const existing = memberships.find(
+        (m) => m.organizationId === organizationId && m.userId === userId,
+      );
+      if (existing) {
+        existing.role = role;
+        return existing;
+      }
+      const row = { organizationId, userId, role };
+      memberships.push(row);
+      return row;
+    },
+    removeMembershipByIds: async (organizationId: string, userId: string) => {
+      const index = memberships.findIndex(
+        (m) => m.organizationId === organizationId && m.userId === userId,
+      );
+      if (index >= 0) memberships.splice(index, 1);
+    },
+    findMembership: async (organizationId: string, userId: string) =>
+      memberships.find(
+        (m) => m.organizationId === organizationId && m.userId === userId,
+      ) ?? null,
+    countAdmins: async (organizationId: string) =>
+      memberships.filter(
+        (m) => m.organizationId === organizationId && m.role === "org:admin",
+      ).length,
+    createInvitation: async (input: {
+      organizationId: string;
+      inviterId: string;
+      email: string;
+      role: string;
+      expiresAt: Date;
+    }) => {
+      const row = {
+        id: `inv-${invitations.length + 1}`,
+        status: "pending",
+        ...input,
+      };
+      invitations.push(row);
+      return row;
+    },
+    findInvitationById: async (id: string) =>
+      invitations.find((i) => i.id === id) ?? null,
+    findPendingInvitation: async (organizationId: string, email: string) =>
+      invitations.find(
+        (i) =>
+          i.organizationId === organizationId &&
+          i.email === email &&
+          i.status === "pending" &&
+          i.expiresAt.getTime() > Date.now(),
+      ) ?? null,
+    listPendingInvitations: async (organizationId: string) =>
+      invitations.filter(
+        (i) =>
+          i.organizationId === organizationId &&
+          i.status === "pending" &&
+          i.expiresAt.getTime() > Date.now(),
+      ),
+    acceptInvitation: async (invitationId: string, userId: string) => {
+      const invitation = invitations.find((i) => i.id === invitationId)!;
+      invitation.status = "accepted";
+      const row = {
+        organizationId: invitation.organizationId,
+        userId,
+        role: invitation.role,
+      };
+      memberships.push(row);
+      return row;
+    },
+    revokeInvitation: async (invitationId: string) => {
+      const invitation = invitations.find((i) => i.id === invitationId);
+      if (invitation && invitation.status === "pending") {
+        invitation.status = "revoked";
+        return true;
+      }
+      return false;
+    },
+    expireInvitation: async (invitationId: string) => {
+      const invitation = invitations.find((i) => i.id === invitationId);
+      if (invitation) invitation.status = "expired";
+    },
+  };
+  const userRepository = {
+    findByAuthEmail: async (email: string) => usersByAuthEmail[email] ?? null,
+    findById: async (id: string) => usersById[id] ?? null,
+  };
+
+  const service = new OrganizationService(
+    organizationRepository as never,
+    userRepository as never,
+    {} as never,
+  );
+  return { service, memberships, invitations };
+}
+
+const ADMIN = { organizationId: "org-1", userId: "admin-1", role: "org:admin" };
+
+describe("OrganizationService.addMember", () => {
+  it("rejects unsupported roles", async () => {
+    const { service, memberships } = build({ memberships: [ADMIN] });
