+import {
+  createParamDecorator,
+  ExecutionContext,
+  UnauthorizedException,
+} from "@nestjs/common";
+import { AUTH_PRINCIPAL_REQUEST_KEY } from "./auth-principal.types";
+import type { CurrentUserData } from "./ownership.types";
+import type { RingeeAuthPrincipal } from "./auth-principal.types";
+
+/**
+ * Provider-neutral current-user decorator.
+ *
+ * Reads the verified principal that the global AuthGuard resolved once per
+ * request. There is no provider fetch and no identity recovery here: if the
+ * principal is missing the request was never authenticated.
+ */
+export const CurrentUser = createParamDecorator(
+  (_data: unknown, ctx: ExecutionContext): CurrentUserData => {
+    const request = ctx.switchToHttp().getRequest();
+    const principal: RingeeAuthPrincipal | undefined =
+      request[AUTH_PRINCIPAL_REQUEST_KEY];
+
+    if (!principal || typeof principal.id !== "string") {
+      throw new UnauthorizedException("No authenticated user in request");
+    }
+
+    return principal;
+  },
+);
