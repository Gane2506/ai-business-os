+
+interface MembershipRow {
+  organizationId: string;
+  userId: string;
+  role: string;
+}
+
+interface InvitationRow {
+  id: string;
+  organizationId: string;
+  email: string;
+  role: string;
+  status: string;
+  expiresAt: Date;
+}
+
+function build(
+  over: {
+    memberships?: MembershipRow[];
+    usersByAuthEmail?: Record<string, { id: string }>;
+    usersById?: Record<string, { id: string; authEmail: string; authEmailVerified: boolean }>;
+    invitations?: InvitationRow[];
