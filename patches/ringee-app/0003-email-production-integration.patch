@@ -0,0 +1,158 @@
+/// <reference types="node" />
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { createHash } from "node:crypto";
+import { createRequire } from "node:module";
+
+// Stub the package boundaries before loading this unit. No application
+// bootstrap, environment credentials, database, network, or SES client is used.
+const requireUnit = createRequire(__filename);
+const loader = requireUnit("node:module");
+const originalLoad = loader._load;
+const config = { EMAIL_SNS_AUTO_CONFIRM: false };
+loader._load = function (id: string, ...args: unknown[]) {
+  if (id === "@ringee/configuration") return { apiConfiguration: config };
+  if (id === "@ringee/database") return { EmailRepository: class {} };
+  if (id === "@ringee/platform")
+    return {
+      SnsFeedbackVerifier: class {},
+      MauticFeedbackClient: class {},
+      normalizeSesFeedback: (message: { Message: string }) =>
+        JSON.parse(message.Message),
+    };
+  return originalLoad.apply(this, [id, ...args]);
+};
+const { EmailFeedbackService } = requireUnit("./email-feedback.service");
+loader._load = originalLoad;
+
+function setup() {
+  const calls: string[] = [];
+  const events = new Set<string>();
+  const suppressions = new Set<string>();
+  const preferences = new Set<string>();
+  const token = "a".repeat(64);
+  const tokenHash = createHash("sha256").update(token).digest("hex");
+  const feedback = {
+    eventId: "fixed-topic:event-1",
+    providerMessageId: "message-1",
+    type: "Bounce",
+    occurredAt: new Date(),
+    identityDomain: "news.example.com",
+    configurationSet: "ses-marketing",
+    recipients: ["person@example.com"],
+    suppressionReason: "HARD_BOUNCE",
+  };
+  const repo = {
+    findIdentityByDomain: async () => ({
+      domainId: "tenant-a",
+      stream: "MARKETING",
+      configurationSet: "ses-marketing",
+      domain: { rootDomain: "example.com" },
+    }),
+    findDeliveryByMessageId: async () => null,
+    recordFeedbackOnce: async (event: any) => {
+      if (events.has(event.eventId)) return false;
+      events.add(event.eventId);
+      event.suppressions.forEach((entry: any) => suppressions.add(entry.email));
+      calls.push("persist");
+      return true;
+    },
+    findUnsubscribeToken: async (hash: string) =>
+      hash === tokenHash
+        ? {
+            domainId: "tenant-a",
+            email: "person@example.com",
+            category: "PROMOTIONAL",
+          }
+        : null,
+    unsubscribeOnce: async (hash: string) => {
+      if (hash !== tokenHash) return false;
+      preferences.add("tenant-a:person@example.com:PROMOTIONAL");
+      return true;
+    },
+  };
+  const verifier = {
+    verify: async () => ({
+      Type: "Notification",
+      Message: JSON.stringify(feedback),
+    }),
+    confirm: async () => {
+      calls.push("confirm");
+    },
+  };
+  const mautic = {
+    sync: async () => {
+      calls.push("mautic");
+    },
+  };
+  return {
+    calls,
+    events,
+    suppressions,
+    preferences,
+    token,
+    feedback,
+    repo,
+    verifier,
+    mautic,
+    service: new EmailFeedbackService(repo, verifier, mautic),
+  };
+}
+
+describe("Email feedback domain (offline)", () => {
+  it("verifies before tenant lookup or write; invalid signatures cause no mutation", async () => {
+    const state = setup();
+    state.verifier.verify = async () => {
+      throw new Error("invalid signature");
+    };
+    await assert.rejects(
+      state.service.receive("{}"),
+      /Invalid SNS notification/,
+    );
+    assert.equal(state.events.size, 0);
+    assert.deepEqual(state.calls, []);
+  });
+  it("applies suppression once and retries native DNC after a failed sync", async () => {
+    const state = setup();
+    state.mautic.sync = async () => {
+      throw new Error("temporary network failure");
+    };
+    await assert.rejects(state.service.receive("{}"), /temporary/);
+    state.mautic.sync = async () => {
+      state.calls.push("mautic");
+    };
+    await state.service.receive("{}");
+    assert.equal(state.events.size, 1);
+    assert.equal(state.suppressions.size, 1);
+    assert.deepEqual(state.calls, ["persist", "mautic"]);
+  });
+  it("rejects configuration set and delivery ownership mismatches", async () => {
+    const state = setup();
+    state.feedback.configurationSet = "ses-auth";
+    await assert.rejects(state.service.receive("{}"), /configuration set/);
+    assert.equal(state.events.size, 0);
+    state.feedback.configurationSet = "ses-marketing";
+    state.repo.findDeliveryByMessageId = async () =>
+      ({ domainId: "tenant-b", stream: "AUTH" }) as any;
+    await assert.rejects(state.service.receive("{}"), /ownership mismatch/);
+    assert.equal(state.events.size, 0);
+  });
+  it("unsubscribe token is hashed, reusable, tenant/category scoped and never technical suppression", async () => {
+    const state = setup();
+    await state.service.unsubscribe(state.token);
+    await state.service.unsubscribe(state.token);
+    assert.deepEqual(
+      [...state.preferences],
+      ["tenant-a:person@example.com:PROMOTIONAL"],
+    );
+    assert.equal(state.suppressions.size, 0);
+    await assert.rejects(
+      state.service.unsubscribe("b".repeat(64)),
+      /Invalid unsubscribe token/,
+    );
+    await assert.rejects(
+      state.service.unsubscribe("tenant-b"),
+      /Invalid unsubscribe token/,
+    );
+  });
+});
diff --git a/packages/services/src/services/email-feedback.service.ts b/packages/services/src/services/email-feedback.service.ts
new file mode 100644
index 0000000..aba516a
--- /dev/null
+++ b/packages/services/src/services/email-feedback.service.ts
@@ -0,0 +1,103 @@
+import {
+  BadRequestException,
+  Injectable,
+  ServiceUnavailableException,
+  UnauthorizedException,
+} from "@nestjs/common";
+import { createHash } from "node:crypto";
+import { EmailRepository } from "@ringee/database";
+import {
+  MauticFeedbackClient,
+  normalizeSesFeedback,
+  SnsFeedbackVerifier,
+} from "@ringee/platform";
+import { apiConfiguration } from "@ringee/configuration";
+
+@Injectable()
+export class EmailFeedbackService {
+  constructor(
+    private readonly repository: EmailRepository,
+    private readonly verifier: SnsFeedbackVerifier,
+    private readonly mautic: MauticFeedbackClient,
+  ) {}
+
+  async receive(raw: Buffer | string): Promise<{ received: true }> {
+    const envelope = await this.verifier.verify(raw).catch(() => {
+      throw new UnauthorizedException("Invalid SNS notification");
+    });
+    if (envelope.Type === "SubscriptionConfirmation") {
+      if (!apiConfiguration.EMAIL_SNS_AUTO_CONFIRM)
+        throw new ServiceUnavailableException(
+          "SNS automatic confirmation is disabled",
+        );
+      await this.verifier.confirm(envelope);
+      return { received: true };
+    }
+    if (envelope.Type === "UnsubscribeConfirmation") {
+      // Never automatically re-subscribe or visit an unsubscribe URL.
+      throw new ServiceUnavailableException(
+        "SES feedback subscription needs administrative review",
+      );
+    }
+    const feedback = (() => {
+      try {
+        return normalizeSesFeedback(envelope);
+      } catch {
+        throw new BadRequestException("Invalid SES event");
+      }
+    })();
+    const identity = await this.repository.findIdentityByDomain(
+      feedback.identityDomain,
+    );
+    if (!identity || identity.configurationSet !== feedback.configurationSet) {
+      throw new BadRequestException(
+        "SES identity or configuration set is not registered",
+      );
+    }
+    const delivery = await this.repository.findDeliveryByMessageId(
+      feedback.providerMessageId,
+    );
+    if (
+      delivery &&
+      (delivery.domainId !== identity.domainId ||
+        delivery.stream !== identity.stream)
+    ) {
+      throw new BadRequestException("SES delivery ownership mismatch");
+    }
+    await this.repository.recordFeedbackOnce({
+      eventId: feedback.eventId,
+      messageId: feedback.providerMessageId,
+      domainId: identity.domainId,
+      stream: identity.stream,
+      type: feedback.type,
+      occurredAt: feedback.occurredAt,
+      // No message content, IP addresses, certificate, raw SNS token, or subject retained.
+      details: {
+        recipients: feedback.recipients,
+        identityDomain: feedback.identityDomain,
+      },
+      suppressions: feedback.suppressionReason
+        ? feedback.recipients.map((email) => ({
+            email,
+            reason: feedback.suppressionReason!,
+            providerMessageId: feedback.providerMessageId,
+          }))
+        : [],
+    });
+    // Repeating this native DNC upsert is deliberate: an earlier network failure
+    // must remain retryable even when the database already contains the event.
+    await this.mautic.sync(identity.domain.rootDomain, feedback);
+    return { received: true };
+  }
+
+  async unsubscribe(token: string): Promise<{ unsubscribed: true }> {
+    if (!/^(?:[A-Za-z0-9_-]{43}|[a-f0-9]{64})$/.test(token))
+      throw new BadRequestException("Invalid unsubscribe token");
+    const hash = createHash("sha256").update(token).digest("hex");
+    const record = await this.repository.findUnsubscribeToken(hash);
+    if (!record) throw new BadRequestException("Invalid unsubscribe token");
+    if (!(await this.repository.unsubscribeOnce(hash)))
+      throw new BadRequestException("Invalid unsubscribe token");
+    return { unsubscribed: true };
+  }
+}
diff --git a/packages/services/src/services/email.service.spec.ts b/packages/services/src/services/email.service.spec.ts
