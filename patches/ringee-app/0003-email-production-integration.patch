+import { Injectable } from "@nestjs/common";
+import { Prisma } from "@prisma/client";
+import { PrismaService } from "../prisma.service";
+
+/** Persistence projection only; enrollment and access decisions live in services. */
+@Injectable()
+export class AuthSessionRepository {
+  constructor(private readonly prisma: PrismaService) {}
+
+  /**
+   * Revoke every session for a user (ban, password change, account closure).
+   * Returns the number of sessions revoked. Deleting the rows is the
+   * revocation: the session reader only accepts rows it can find.
+   */
+  async revokeAllForUser(userId: string): Promise<number> {
+    const { count } = await this.prisma.authSession.deleteMany({
+      where: { userId },
+    });
+    return count;
+  }
+
+  async findPrincipalSnapshot(sessionId: string, userId: string, now: Date) {
+    return this.prisma.$transaction(
+      async (tx) => {
+        const session = await tx.authSession.findFirst({
+          where: { id: sessionId, userId, expiresAt: { gt: now } },
+          select: {
+            id: true,
+            userId: true,
+            expiresAt: true,
+            activeOrganizationId: true,
+            user: {
+              select: {
+                id: true,
+                authEmail: true,
+                authName: true,
+                authEmailVerified: true,
+                imageUrl: true,
+                blockedAt: true,
+                encryptionKey: true,
+                phoneRequired: true,
+                phoneVerified: true,
+                phoneNumber: true,
+                canCall: true,
+                emails: {
+                  select: { email: true, status: true, isPrimary: true },
+                },
+              },
+            },
+          },
+        });
+        if (!session) return null;
+        const membership =
+          session.activeOrganizationId === null
+            ? null
+            : await tx.organizationMembership.findFirst({
+                where: { organizationId: session.activeOrganizationId, userId },
+                select: {
+                  userId: true,
+                  organizationId: true,
+                  role: true,
+                  organization: {
+                    select: {
+                      id: true,
+                      name: true,
+                      slug: true,
+                      imageUrl: true,
+                    },
+                  },
+                },
+              });
+        return { session, membership };
+      },
+      { isolationLevel: Prisma.TransactionIsolationLevel.RepeatableRead },
+    );
+  }
+}
