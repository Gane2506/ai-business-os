index 0000000..6d4d993
--- /dev/null
+++ b/packages/services/src/services/email.service.spec.ts
@@ -0,0 +1,283 @@
+import "reflect-metadata";
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { apiConfiguration } from "@ringee/configuration";
+import { EMAIL_STREAMS, EmailSendUncertainError } from "@ringee/platform";
+import { EmailService } from "./email.service";
+
+const domainId = "00000000-0000-4000-8000-000000000001";
+const ctx = { userId: "user-a", organizationId: "org-a" };
+const message = {
+  to: "person@example.net",
+  subject: "Subject",
+  html: "<p>Body</p>",
+};
+function build(
+  options: {
+    unauthorized?: boolean;
+    suppressed?: boolean;
+    unsubscribed?: string;
+    ready?: boolean;
+    unknown?: boolean;
+    persistenceFailure?: boolean;
+  } = {},
+) {
+  Object.assign(apiConfiguration, {
+    EMAIL_SEND_ENABLED: true,
+    EMAIL_PLATFORM_DOMAIN_ID: domainId,
+    AWS_SES_REGION: "ca-central-1",
+    EMAIL_SNS_TOPIC_ARN: "arn:aws:sns:ca-central-1:111111111111:ses",
+    EMAIL_UNSUBSCRIBE_BASE_URL: "https://app.example.com/api/email/unsubscribe",
+  });
+  const domain = {
+    id: domainId,
+    rootDomain: "example.com",
+    region: "ca-central-1",
+    enabled: true,
+    outreachEnabled: false,
+    identities: Object.entries(EMAIL_STREAMS).map(([stream, map]) => ({
+      stream,
+      identityDomain: `${map.prefix}.example.com`,
+      configurationSet: map.configurationSet,
+      enabled: true,
+    })),
+  };
+  const sent: any[] = [],
+    tokens: any[] = [],
+    scopedLookups: any[] = [],
+    preferences: string[] = [];
+  const deliveries: any[] = [];
+  const repository = {
+    findDomainForOwner: async (owner: object, id: string) => {
+      scopedLookups.push({ owner, id });
+      return options.unauthorized ? null : domain;
+    },
+    findPlatformDomain: async () => domain,
+    findSuppression: async () =>
+      options.suppressed ? { reason: "HARD_BOUNCE" } : null,
+    findPreference: async (_id: string, _to: string[], category: string) => {
+      preferences.push(category);
+      return options.unsubscribed === category ? {} : null;
+    },
+    updateIdentityStatus: async () => {},
+    beginDelivery: async (input: any) => {
+      const existing = deliveries.find(
+        (row) =>
+          row.operationKey === input.operationKey ||
+          (row.fingerprint === input.fingerprint &&
+            ["SENDING", "UNKNOWN"].includes(row.status)),
+      );
+      if (existing) return { delivery: existing, claimed: false };
+      const delivery = {
+        ...input,
+        id: `00000000-0000-4000-8000-00000000000${deliveries.length + 2}`,
+        status: "SENDING",
+      };
+      deliveries.push(delivery);
+      return { delivery, claimed: true };
+    },
+    finishDelivery: async (id: string, status: string, messageId?: string) => {
+      if (options.persistenceFailure && status === "ACCEPTED")
+        throw new Error("database unavailable");
+      Object.assign(
+        deliveries.find((row) => row.id === id),
+        { status, messageId },
+      );
+    },
+    createUnsubscribeToken: async (input: unknown) => {
+      tokens.push(input);
+    },
+  };
+  const service = new EmailService(repository as never);
+  Object.assign(service, {
+    provider: {
+      getIdentityStatus: async () => ({
+        ready: options.ready !== false,
+        verificationStatus: "SUCCESS",
+        dkimStatus: "SUCCESS",
+        mailFromStatus: "SUCCESS",
+      }),
+      sendEmail: async (input: unknown) => {
+        sent.push(input);
+        if (options.unknown) throw new EmailSendUncertainError();
+        return { data: { id: `ses-${sent.length}` }, sent: true };
+      },
+    },
+  });
+  return {
+    service,
+    domain,
+    sent,
+    deliveries,
+    tokens,
+    scopedLookups,
+    preferences,
+  };
+}
+
+describe("central email policy", () => {
+  it("passes canonical ownership context and refuses a domain from another tenant", async () => {
+    const { service, sent, scopedLookups } = build({ unauthorized: true });
+    await assert.rejects(
+      service.sendEmail(ctx, { ...message, domainId, stream: "AUTH" }),
+      /DOMAIN_NOT_AUTHORIZED/,
+    );
+    assert.deepEqual(scopedLookups, [{ owner: ctx, id: domainId }]);
+    assert.equal(sent.length, 0);
+  });
+  it("uses the explicit platform domain for pre-auth sends", async () => {
+    const { service, sent, scopedLookups } = build();
+    await service.sendPlatformEmail("AUTH", message);
+    assert.equal(sent[0].from, "noreply@auth.example.com");
+    assert.equal(scopedLookups.length, 0);
+  });
+  it("fails closed with sending disabled", async () => {
+    const { service, sent, deliveries } = build();
+    apiConfiguration.EMAIL_SEND_ENABLED = false;
+    await assert.rejects(
+      service.sendPlatformEmail("AUTH", message),
+      /SENDING_DISABLED/,
+    );
+    assert.equal(sent.length, 0);
+    assert.equal(deliveries.length, 0);
+  });
+  for (const from of [
+    "noreply@example.com",
+    "noreply@auth.other.com",
+    "noreply@news.example.com",
+    "verify@auth.example.com",
+  ]) {
+    it(`blocks unauthorized sender ${from}`, async () => {
+      const { service, sent } = build();
+      await assert.rejects(
+        service.sendPlatformEmail("AUTH", { ...message, from }),
+        /UNAUTHORIZED_FROM/,
+      );
+      assert.equal(sent.length, 0);
+    });
+  }
+  it("refuses incomplete verification and disabled outreach", async () => {
+    const { service, sent } = build({ ready: false });
+    await assert.rejects(
+      service.sendPlatformEmail("AUTH", message),
+      /IDENTITY_NOT_READY/,
+    );
+    await assert.rejects(
+      service.sendPlatformEmail("OUTREACH", message),
+      /OUTREACH_DISABLED/,
+    );
+    assert.equal(sent.length, 0);
+  });
+  for (const stream of Object.keys(EMAIL_STREAMS)) {
+    it(`technical suppression blocks ${stream}`, async () => {
+      const { service, domain, sent } = build({ suppressed: true });
+      domain.outreachEnabled = true;
+      await assert.rejects(
+        service.sendPlatformEmail(
+          stream as keyof typeof EMAIL_STREAMS,
+          message,
+        ),
+        /RECIPIENT_SUPPRESSED/,
+      );
+      assert.equal(sent.length, 0);
+    });
+  }
+  it("promotional unsubscribe does not block authentication or marketing", async () => {
+    const { service, sent, preferences } = build({
+      unsubscribed: "PROMOTIONAL",
+    });
+    await assert.rejects(
+      service.sendPlatformEmail("PROMOTIONAL", message),
+      /RECIPIENT_UNSUBSCRIBED/,
+    );
+    await service.sendPlatformEmail("AUTH", message);
+    await service.sendPlatformEmail("MARKETING", message);
+    assert.equal(sent.length, 2);
+    assert.deepEqual(preferences, ["PROMOTIONAL", "MARKETING"]);
+  });
+  it("optional sends persist only a token hash and link the exact category", async () => {
+    const { service, sent, tokens } = build();
+    await service.sendPlatformEmail("MARKETING", { ...message, text: "Body" });
+    assert.equal(tokens[0].category, "MARKETING");
+    assert.equal(tokens[0].email, message.to);
+    assert.match(tokens[0].tokenHash, /^[a-f0-9]{64}$/);
+    const url = sent[0].unsubscribeUrl;
+    assert.match(
+      url,
+      /^https:\/\/app.example.com\/api\/email\/unsubscribe\/[a-f0-9]{64}$/,
+    );
+    assert.ok(!url.includes(tokens[0].tokenHash));
+    assert.ok(sent[0].html.includes(url));
+    assert.ok(sent[0].text.includes(url));
+  });
+  it("never shares a recipient's unsubscribe token with cc/bcc", async () => {
+    const { service } = build();
+    await assert.rejects(
+      service.sendPlatformEmail("MARKETING", {
+        ...message,
+        cc: "other@example.net",
+      }),
+      /SINGLE_RECIPIENT/,
+    );
+  });
+  it("blocks a repeated ambiguous send even without an operation key", async () => {
+    const { service, sent, deliveries } = build({ unknown: true });
+    await assert.rejects(
+      service.sendPlatformEmail("AUTH", message),
+      EmailSendUncertainError,
+    );
+    await assert.rejects(
+      service.sendPlatformEmail("AUTH", message),
+      EmailSendUncertainError,
+    );
+    assert.equal(sent.length, 1);
+    assert.equal(deliveries[0].status, "UNKNOWN");
+  });
+  it("blocks ambiguous replay when recipient ordering changes", async () => {
+    const { service, sent } = build({ unknown: true });
+    await assert.rejects(
+      service.sendPlatformEmail("AUTH", {
+        ...message,
+        to: ["a@example.net", "b@example.net"],
+      }),
+      EmailSendUncertainError,
+    );
+    await assert.rejects(
+      service.sendPlatformEmail("AUTH", {
+        ...message,
+        to: ["b@example.net", "a@example.net"],
+      }),
+      EmailSendUncertainError,
+    );
+    assert.equal(sent.length, 1);
+  });
+  it("blocks replay when acceptance persistence fails", async () => {
+    const { service, sent } = build({ persistenceFailure: true });
+    await assert.rejects(
+      service.sendPlatformEmail("AUTH", message),
+      EmailSendUncertainError,
+    );
+    await assert.rejects(
+      service.sendPlatformEmail("AUTH", message),
+      EmailSendUncertainError,
+    );
+    assert.equal(sent.length, 1);
+  });
+  it("replays an accepted operation without resending and rejects reused keys with new content", async () => {
+    const { service, sent } = build();
+    const input = { ...message, operationKey: "otp-challenge-123" };
+    const first = await service.sendPlatformEmail("AUTH", input);
+    assert.deepEqual(await service.sendPlatformEmail("AUTH", input), first);
+    await assert.rejects(
+      service.sendPlatformEmail("AUTH", { ...input, html: "Changed" }),
+      /OPERATION_KEY_REUSED/,
+    );
+    assert.equal(sent.length, 1);
+  });
+  it("allows intentional identical messages after confirmed acceptance", async () => {
+    const { service, sent } = build();
+    await service.sendPlatformEmail("AUTH", message);
+    await service.sendPlatformEmail("AUTH", message);
+    assert.equal(sent.length, 2);
+  });
+});
diff --git a/packages/services/src/services/email.service.ts b/packages/services/src/services/email.service.ts
