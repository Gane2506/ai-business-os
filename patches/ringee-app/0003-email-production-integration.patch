+-- Run only against a disposable migrated database; every fixture rolls back.
+BEGIN;
+DO $$
+DECLARE
+  platform_id uuid := '00000000-0000-4000-8000-000000000001';
+  tenant_id uuid := '00000000-0000-4000-8000-000000000002';
+  user_id uuid := '00000000-0000-4000-8000-000000000003';
+BEGIN
+  INSERT INTO "User" (id, "updatedAt") VALUES (user_id, now());
+  INSERT INTO "EmailDomain" (id, platform, "rootDomain", region, "updatedAt")
+    VALUES (platform_id, true, 'platform.example.invalid', 'ca-central-1', now());
+  INSERT INTO "EmailDomain" (id, "userId", "rootDomain", region, "updatedAt")
+    VALUES (tenant_id, user_id, 'tenant.example.invalid', 'ca-central-1', now());
+  BEGIN
+    INSERT INTO "EmailDomain" (id, platform, "userId", "rootDomain", region, "updatedAt")
+      VALUES (gen_random_uuid(), true, user_id, 'bad.example.invalid', 'ca-central-1', now());
+    RAISE EXCEPTION 'platform with workspace owner unexpectedly allowed';
+  EXCEPTION WHEN check_violation THEN NULL;
+  END;
+  BEGIN
+    INSERT INTO "EmailDomain" (id, "rootDomain", region, "updatedAt")
+      VALUES (gen_random_uuid(), 'orphan.example.invalid', 'ca-central-1', now());
+    RAISE EXCEPTION 'tenant without owner unexpectedly allowed';
+  EXCEPTION WHEN check_violation THEN NULL;
+  END;
+  INSERT INTO "EmailDelivery" (id, "domainId", stream, "operationKey", fingerprint, recipients, "updatedAt")
+    VALUES (gen_random_uuid(), platform_id, 'AUTH', 'attempt-1', 'same-message', '["person@example.invalid"]', now());
+  BEGIN
+    INSERT INTO "EmailDelivery" (id, "domainId", stream, "operationKey", fingerprint, recipients, "updatedAt")
+      VALUES (gen_random_uuid(), platform_id, 'AUTH', 'attempt-2', 'same-message', '[]', now());
+    RAISE EXCEPTION 'concurrent duplicate send unexpectedly allowed';
+  EXCEPTION WHEN unique_violation THEN NULL;
+  END;
+  UPDATE "EmailDelivery" SET status='UNKNOWN' WHERE "operationKey"='attempt-1';
+  BEGIN
+    INSERT INTO "EmailDelivery" (id, "domainId", stream, "operationKey", fingerprint, recipients, "updatedAt")
+      VALUES (gen_random_uuid(), platform_id, 'AUTH', 'attempt-3', 'same-message', '[]', now());
+    RAISE EXCEPTION 'ambiguous duplicate send unexpectedly allowed';
+  EXCEPTION WHEN unique_violation THEN NULL;
+  END;
+  UPDATE "EmailDelivery" SET status='ACCEPTED', "messageId"='accepted-1' WHERE "operationKey"='attempt-1';
+  INSERT INTO "EmailDelivery" (id, "domainId", stream, "operationKey", fingerprint, recipients, "updatedAt")
+    VALUES (gen_random_uuid(), platform_id, 'AUTH', 'attempt-4', 'same-message', '[]', now());
+  INSERT INTO "EmailPreference" (id, "domainId", email, category, "unsubscribedAt")
+    VALUES (gen_random_uuid(), tenant_id, 'person@example.invalid', 'PROMOTIONAL', now());
+  IF EXISTS (SELECT 1 FROM "EmailSuppression" WHERE email='person@example.invalid') THEN
+    RAISE EXCEPTION 'optional unsubscribe contaminated technical suppression';
+  END IF;
+  IF EXISTS (SELECT 1 FROM "EmailPreference" WHERE "domainId"=platform_id AND email='person@example.invalid') THEN
+    RAISE EXCEPTION 'tenant preference leaked to platform';
+  END IF;
+  IF EXISTS (SELECT 1 FROM "EmailPreference" WHERE "domainId"=tenant_id AND category='MARKETING') THEN
+    RAISE EXCEPTION 'promotional preference leaked to marketing';
+  END IF;
+  RAISE NOTICE 'email ownership, ambiguous send uniqueness, and preference separation invariants passed';
+END $$;
+ROLLBACK;
