@@ -0,0 +1,75 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Inject,
+  Injectable,
+} from "@nestjs/common";
+import { Reflector } from "@nestjs/core";
+import {
+  AUTH_PRINCIPAL_REQUEST_KEY,
+  AUTH_RUNTIME_TOKEN,
+  IS_PUBLIC_KEY,
+  type AuthSessionReader,
+  type RingeeAuthPrincipal,
+} from "@ringee/platform";
+import { AuthPrincipalService } from "@ringee/services";
+
+/**
+ * Global authentication guard. Every route is denied by default; only
+ * handlers marked `@Public()` skip authentication (each such route must
+ * carry its own proof of authorization).
+ *
+ * The complete server principal is resolved once per request through the
+ * provider-neutral AuthPrincipalService and stored on the request under a
+ * neutral key. Route-scoped guards and the @CurrentUser() decorator read
+ * that principal — never provider request fields.
+ */
+@Injectable()
+export class AuthGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly principalService: AuthPrincipalService,
+    @Inject(AUTH_RUNTIME_TOKEN)
+    private readonly sessionReader: AuthSessionReader,
+  ) {}
+
+  async canActivate(context: ExecutionContext): Promise<boolean> {
+    const isPublic = this.reflector.getAllAndOverride<boolean>(IS_PUBLIC_KEY, [
+      context.getHandler(),
+      context.getClass(),
+    ]);
+
+    if (isPublic) {
+      return true;
+    }
+
+    const request = context.switchToHttp().getRequest();
+    const principal = await this.principalService.resolve(
+      this.sessionReader,
+      toWebHeaders(request.headers),
+    );
+
+    request[AUTH_PRINCIPAL_REQUEST_KEY] =
+      principal satisfies RingeeAuthPrincipal;
+    // Neutral fields for route-scoped guards (org admin, voice agent, ...).
+    request.activeOrgId = principal.activeOrgId;
+    request.activeOrgRole = principal.activeOrgRole;
+    return true;
+  }
+}
+
+/** Copy Express headers into a Web Headers instance for the session reader. */
+function toWebHeaders(
+  input: Record<string, string | string[] | undefined> | undefined,
+): Headers {
+  const headers = new Headers();
+  for (const [name, value] of Object.entries(input ?? {})) {
+    if (value === undefined) continue;
+    if (Array.isArray(value)) {
+      for (const entry of value) headers.append(name, entry);
+    } else {
+      headers.append(name, value);
+    }
+  }
+  return headers;
+}
