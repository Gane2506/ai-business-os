@@ -0,0 +1,67 @@
+import { z } from "zod";
+import { ApiError, type ApiClient } from "../lib/api";
+
+// This is the sanitized Ringee principal, never Better Auth's session/token DTO.
+export const authPrincipalSchema = z.object({
+  user: z.object({
+    id: z.string().uuid(),
+    email: z.string().email(),
+    emailVerified: z.boolean(),
+    name: z.string(),
+    imageUrl: z.string().nullable(),
+  }),
+  organization: z
+    .object({
+      id: z.string().uuid(),
+      name: z.string(),
+      slug: z.string().nullable(),
+      imageUrl: z.string().nullable(),
+      role: z.enum(["org:admin", "org:member"]),
+    })
+    .nullable(),
+  phoneAccess: z.object({
+    required: z.boolean(),
+    verified: z.boolean(),
+  }),
+  expiresAt: z.string().datetime(),
+});
+
+export type AuthPrincipal = z.infer<typeof authPrincipalSchema>;
+
+export async function readAuthPrincipal(
+  api: ApiClient,
+): Promise<AuthPrincipal | null> {
+  try {
+    const response = await api.get<unknown>("/auth/principal");
+    if (response === null) return null;
+    const principal = authPrincipalSchema.parse(response);
+    if (Date.parse(principal.expiresAt) <= Date.now()) {
+      throw new ApiError("Authentication session expired", 401);
+    }
+    return principal;
+  } catch (error) {
+    if (error instanceof ApiError && error.status === 401) return null;
+    throw error;
+  }
+}
+
+export function signInDestination(
+  principal: AuthPrincipal,
+  requested?: string | null,
+): string {
+  // Preserve the server's phoneRequired waiver: unverified is not always required.
+  if (principal.phoneAccess.required && !principal.phoneAccess.verified) {
+    return "/auth/verify-phone";
+  }
+  if (
+    !requested ||
+    !requested.startsWith("/") ||
+    requested.startsWith("//") ||
+    Array.from(requested).some(
+      (character) => character === "\\" || character.charCodeAt(0) <= 0x20,
+    )
+  ) {
+    return "/dashboard";
+  }
+  return requested;
+}
