+  TRANSACTIONAL: { prefix: "tx", configurationSet: "ses-transactional" },
+  COMMUNICATION: { prefix: "mail", configurationSet: "ses-communication" },
+  MARKETING: { prefix: "news", configurationSet: "ses-marketing" },
+  PROMOTIONAL: { prefix: "offers", configurationSet: "ses-promotional" },
+  OUTREACH: { prefix: "outreach", configurationSet: "ses-outreach" },
+} as const;
+
+export type EmailStreamName = keyof typeof EMAIL_STREAMS;
+
+export function normalizeEmailAddress(value: string): string {
+  const email = value.trim().toLowerCase();
+  if (
+    !/^[^\s<>@,;]+@(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,63}$/.test(
+      email,
+    )
+  ) {
+    throw new Error("Invalid email address");
+  }
+  return email;
+}
+
+export function normalizeEmailRootDomain(value: string): string {
+  const root = value.trim().toLowerCase();
+  if (!/^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,63}$/.test(root)) {
+    throw new Error("Invalid email root domain");
+  }
+  return root;
+}
+
+export function emailStreamIdentity(root: string, stream: EmailStreamName) {
+  if (!Object.prototype.hasOwnProperty.call(EMAIL_STREAMS, stream)) {
+    throw new Error("Unknown email stream");
+  }
+  return `${EMAIL_STREAMS[stream].prefix}.${normalizeEmailRootDomain(root)}`;
+}
+
+/** Ambiguous network failures must never be retried automatically by callers. */
+export class EmailSendUncertainError extends Error {
+  readonly retryable = false;
+  constructor() {
+    super("Email acceptance is uncertain; automatic retry is disabled");
+    this.name = "EmailSendUncertainError";
+  }
+}
