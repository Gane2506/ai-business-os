+    await assert.rejects(
+      service.removeMember("org-1", "admin-1"),
+      ForbiddenException,
+    );
+    assert.deepEqual(memberships, [ADMIN]);
+  });
+
+  it("removes an administrator when another remains", async () => {
+    const { service, memberships } = build({
+      memberships: [
+        ADMIN,
+        { organizationId: "org-1", userId: "admin-2", role: "org:admin" },
+      ],
+    });
+    await service.removeMember("org-1", "admin-1");
+    assert.deepEqual(memberships, [
+      { organizationId: "org-1", userId: "admin-2", role: "org:admin" },
+    ]);
+  });
+
+  it("removes a plain member without an admin check", async () => {
+    const { service, memberships } = build({
+      memberships: [
+        ADMIN,
+        { organizationId: "org-1", userId: "user-2", role: "org:member" },
+      ],
+    });
+    await service.removeMember("org-1", "user-2");
+    assert.deepEqual(memberships, [ADMIN]);
+  });
+
+  it("is a no-op for a non-member", async () => {
+    const { service, memberships } = build({ memberships: [ADMIN] });
+    await service.removeMember("org-1", "ghost");
+    assert.deepEqual(memberships, [ADMIN]);
+  });
+});
+
+describe("OrganizationService.inviteMember", () => {
+  it("forbids non-admins from inviting", async () => {
+    const { service, invitations } = build({
+      memberships: [
+        ADMIN,
+        { organizationId: "org-1", userId: "user-2", role: "org:member" },
+      ],
+    });
+    await assert.rejects(
+      service.inviteMember("org-1", "user-2", "new@example.com", "org:member"),
+      ForbiddenException,
+    );
+    assert.deepEqual(invitations, []);
+  });
+
+  it("rejects unsupported roles", async () => {
+    const { service } = build({ memberships: [ADMIN] });
+    await assert.rejects(
+      service.inviteMember("org-1", "admin-1", "new@example.com", "owner"),
+      ConflictException,
+    );
+  });
+
+  it("adds an enrolled user directly", async () => {
+    const { service, memberships } = build({
+      memberships: [ADMIN],
