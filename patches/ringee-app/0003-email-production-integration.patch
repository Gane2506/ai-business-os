@@ -0,0 +1,227 @@
+import { Injectable } from "@nestjs/common";
+import { EmailStream, EmailPreferenceCategory, Prisma } from "@prisma/client";
+import {
+  OwnershipContext,
+  buildOwnershipFilter,
+  buildOwnershipData,
+} from "@ringee/platform";
+import { PrismaService } from "../prisma.service";
+
+export interface EmailFeedbackInput {
+  eventId: string;
+  messageId: string;
+  domainId?: string;
+  stream?: EmailStream;
+  type: string;
+  occurredAt: Date;
+  details: Prisma.InputJsonValue;
+  suppressions: Array<{
+    email: string;
+    reason: string;
+    providerMessageId?: string;
+  }>;
+}
+
+@Injectable()
+export class EmailRepository {
+  constructor(private readonly prisma: PrismaService) {}
+
+  findDomainForOwner(ctx: OwnershipContext, id: string) {
+    return this.prisma.emailDomain.findFirst({
+      where: { id, platform: false, ...buildOwnershipFilter(ctx) },
+      include: { identities: true },
+    });
+  }
+  findPlatformDomain(id: string) {
+    return this.prisma.emailDomain.findFirst({
+      where: { id, platform: true, userId: null, organizationId: null },
+      include: { identities: true },
+    });
+  }
+  createDomain(
+    ctx: OwnershipContext,
+    input: {
+      rootDomain: string;
+      region: string;
+      identities: Array<{
+        stream: EmailStream;
+        identityDomain: string;
+        configurationSet: string;
+      }>;
+    },
+  ) {
+    const { identities, ...data } = input;
+    return this.prisma.emailDomain.create({
+      data: {
+        ...data,
+        ...buildOwnershipData(ctx),
+        identities: { create: identities },
+      },
+      include: { identities: true },
+    });
+  }
+  updateIdentityStatus(
+    domainId: string,
+    stream: EmailStream,
+    status: {
