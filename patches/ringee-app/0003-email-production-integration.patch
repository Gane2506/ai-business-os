+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { ApiClient, ApiError } from "../../lib/api";
+import {
+  readAuthPrincipal,
+  signInDestination,
+  authPrincipalSchema,
+} from "../contracts";
+import { createRingeeAuthClient } from "../client";
+import { createCookieApiServer } from "../../lib/api.server";
+
+const principal = {
+  user: {
+    id: "00000000-0000-4000-8000-000000000001",
+    email: "stage@example.invalid",
+    emailVerified: true,
+    name: "Stage",
+    imageUrl: null,
+  },
+  organization: null,
+  phoneAccess: { required: false, verified: false },
+  expiresAt: "2099-01-01T00:00:00.000Z",
+};
+test("phone waiver and local navigation preserve backend decision", () => {
+  assert.equal(signInDestination(principal), "/dashboard");
+  assert.equal(
+    signInDestination({
+      ...principal,
+      phoneAccess: { required: true, verified: false },
+    }),
+    "/auth/verify-phone",
+  );
+  assert.equal(
+    signInDestination(
+      { ...principal, phoneAccess: { required: true, verified: true } },
+      "/cli/authorize",
+    ),
+    "/cli/authorize",
+  );
+  for (const destination of [
+    "https://evil.invalid",
+    "//evil.invalid",
+    "/\\evil.invalid",
+    "/\nevil.invalid",
+  ]) {
+    assert.equal(signInDestination(principal, destination), "/dashboard");
+  }
+});
+test("principal projection strips credentials and denies malformed roles", () => {
+  const parsed = authPrincipalSchema.parse({
+    ...principal,
+    token: "must-never-escape",
+    user: { ...principal.user, privateMetadata: { secret: true } },
+  });
+  assert.deepEqual(parsed, principal);
+  assert.throws(() =>
+    authPrincipalSchema.parse({
+      ...principal,
+      organization: {
+        id: principal.user.id,
+        name: "Org",
+        slug: null,
+        imageUrl: null,
+        role: "org:admin-untrusted",
+      },
+    }),
+  );
+  assert.throws(() =>
+    authPrincipalSchema.parse({
+      ...principal,
+      user: { ...principal.user, id: "clerk_user" },
+    }),
+  );
+});
+test("anonymous and expired sessions differ from backend failures", async () => {
+  const original = globalThis.fetch;
+  const api = new ApiClient({
+    baseURL: "https://calls-api.connectxmedia.com/api",
+  });
+  try {
+    globalThis.fetch = async () => new Response("null");
+    assert.equal(await readAuthPrincipal(api), null);
+    globalThis.fetch = async () => new Response("{}", { status: 401 });
+    assert.equal(await readAuthPrincipal(api), null);
+    globalThis.fetch = async () =>
+      new Response(
+        JSON.stringify({ ...principal, expiresAt: "2000-01-01T00:00:00.000Z" }),
+      );
+    assert.equal(await readAuthPrincipal(api), null);
+    globalThis.fetch = async () => new Response("{}", { status: 503 });
+    await assert.rejects(
+      readAuthPrincipal(api),
+      (error) => error instanceof ApiError && error.status === 503,
+    );
+  } finally {
+    globalThis.fetch = original;
+  }
+});
+test("request-scoped server cookies stay isolated and GET bypasses cache", async () => {
+  const original = globalThis.fetch;
+  const requests: RequestInit[] = [];
+  try {
+    globalThis.fetch = async (_input, init) => {
+      requests.push(init!);
+      return new Response("{}");
+    };
+    const first = createCookieApiServer(
+      "ringee.session=first",
+      "https://calls-api.connectxmedia.com/api",
+    );
+    const second = createCookieApiServer(
+      "ringee.session=second",
+      "https://calls-api.connectxmedia.com/api",
+    );
+    await Promise.all([first.get("/user"), second.get("/user")]);
+    assert.deepEqual(
+      requests.map((r) => (r.headers as Record<string, string>).Cookie),
+      ["ringee.session=first", "ringee.session=second"],
+    );
+    assert.ok(
+      requests.every(
+        (r) => r.cache === "no-store" && r.credentials === "include",
+      ),
+    );
+    assert.ok(
+      requests.every(
+        (r) => !("Authorization" in (r.headers as Record<string, string>)),
+      ),
+    );
+  } finally {
+    globalThis.fetch = original;
+  }
+});
+test("browser SDK auth uses credentials and only exposes Ringee principal", async () => {
+  const original = globalThis.fetch;
+  const requests: Request[] = [];
+  try {
+    globalThis.fetch = async (input, init) => {
+      const request = new Request(input, init);
+      requests.push(request);
+      const path = new URL(request.url).pathname;
+      if (path === "/api/auth/sign-in/email")
+        return new Response(
+          JSON.stringify({
+            token: "private-provider-token",
+            user: { id: principal.user.id },
+          }),
+          { headers: { "Content-Type": "application/json" } },
+        );
+      if (path === "/api/auth/principal")
+        return new Response(JSON.stringify(principal), {
+          headers: { "Content-Type": "application/json" },
+        });
+      if (path === "/api/auth/sign-out")
+        return new Response(JSON.stringify({ success: true }), {
+          headers: { "Content-Type": "application/json" },
+        });
+      throw new Error("Unexpected path " + path);
+    };
+    const client = createRingeeAuthClient(
+      "https://calls-api.connectxmedia.com/api",
+    );
+    assert.deepEqual(
+      await client.signIn({
+        email: "stage@example.invalid",
+        password: "synthetic-fixture",
+      }),
+      principal,
+    );
+    await client.signOut();
+    assert.deepEqual(
+      requests.map((r) => new URL(r.url).pathname),
+      ["/api/auth/sign-in/email", "/api/auth/principal", "/api/auth/sign-out"],
+    );
+    assert.ok(requests.every((r) => r.credentials === "include"));
+    assert.ok(!("token" in (await client.getPrincipal())!));
+  } finally {
+    globalThis.fetch = original;
+  }
+});
+
+test("authentication URL rejects unsafe schemes, credentials and nonlocal HTTP", () => {
+  for (const url of [
+    "javascript:alert(1)",
+    "https://calls-api.connectxmedia.com/other",
+    "ftp://calls-api.connectxmedia.com/api",
+    "http://calls-api.connectxmedia.com/api",
+    "https://name:secret@calls-api.connectxmedia.com/api",
+    "https://calls-api.connectxmedia.com/api?next=other",
+    "https://calls-api.connectxmedia.com/api#fragment",
+  ]) {
+    assert.throws(() => createRingeeAuthClient(url));
+  }
+  assert.doesNotThrow(() =>
+    createRingeeAuthClient("http://localhost:3000/api"),
+  );
+  assert.doesNotThrow(() =>
+    createRingeeAuthClient("https://calls-api.connectxmedia.com/api"),
+  );
+});
+
+test("SDK failures retain status for invalid-credentials versus unavailable UI", async () => {
+  const original = globalThis.fetch;
+  try {
+    for (const status of [401, 503]) {
+      globalThis.fetch = async () =>
+        new Response(JSON.stringify({ message: "Authentication failed" }), {
+          status,
+          headers: { "Content-Type": "application/json" },
+        });
+      const client = createRingeeAuthClient(
+        "https://calls-api.connectxmedia.com/api",
+      );
+      await assert.rejects(
+        client.signIn({
+          email: "stage@example.invalid",
+          password: "synthetic-fixture",
+        }),
+        (error) => error instanceof ApiError && error.status === status,
+      );
+    }
+  } finally {
+    globalThis.fetch = original;
+  }
+});
