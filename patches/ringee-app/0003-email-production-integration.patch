+import { describe, expect, it } from "vitest";
+import { normalizeSesFeedback } from "./ses-feedback";
+import type { SnsEnvelope } from "./sns-feedback.verifier";
+
+const event = (type = "Bounce", permanent = true) => ({
+  eventType: type,
+  mail: {
+    sourceArn:
+      "arn:aws:ses:ca-central-1:123456789012:identity/news.example.com",
+    sendingAccountId: "123456789012",
+    messageId: "ses-message",
+    timestamp: "2026-10-11T00:00:00Z",
+    destination: ["A@example.com"],
+    tags: {
+      "ses:configuration-set": ["ses-marketing"],
+      tenant_id: ["forged-tenant"],
+    },
+  },
+  bounce: {
+    bounceType: permanent ? "Permanent" : "Transient",
+    timestamp: "2026-10-11T00:00:01Z",
+    bouncedRecipients: [{ emailAddress: "A@example.com" }],
+  },
+  complaint: {
+    timestamp: "2026-10-11T00:00:01Z",
+    complainedRecipients: [{ emailAddress: "A@example.com" }],
+  },
+});
+const envelope = (payload: unknown) =>
+  ({
+    Type: "Notification",
+    MessageId: "sns-event",
+    TopicArn: "arn:aws:sns:ca-central-1:123456789012:ses-events",
+    Message: JSON.stringify(payload),
+  }) as SnsEnvelope;
+
+describe("SES feedback normalization", () => {
+  it("uses verified identity and preserves minimal recipients without trusting tenant tags", () => {
+    expect(normalizeSesFeedback(envelope(event()))).toMatchObject({
+      identityDomain: "news.example.com",
+      configurationSet: "ses-marketing",
+      recipients: ["a@example.com"],
+      suppressionReason: "HARD_BOUNCE",
+    });
+  });
+  it("suppresses hard bounce and complaint but not transient bounce, send or not-spam reports", () => {
+    expect(
+      normalizeSesFeedback(envelope(event("Bounce", false))).suppressionReason,
+    ).toBeUndefined();
+    expect(
+      normalizeSesFeedback(envelope(event("Send"))).suppressionReason,
+    ).toBeUndefined();
+    expect(
+      normalizeSesFeedback(envelope(event("Complaint"))).suppressionReason,
+    ).toBe("COMPLAINT");
+    const payload = event("Complaint");
+    (payload.complaint as any).complaintFeedbackType = "not-spam";
+    expect(
+      normalizeSesFeedback(envelope(payload)).suppressionReason,
+    ).toBeUndefined();
+  });
+  it("fails closed on source account mismatch and missing configuration-set evidence", () => {
+    const payload = event();
+    payload.mail.sendingAccountId = "000000000000";
+    expect(() => normalizeSesFeedback(envelope(payload))).toThrow("mismatch");
+    payload.mail.sendingAccountId = "123456789012";
+    payload.mail.tags["ses:configuration-set"] = [];
+    expect(() => normalizeSesFeedback(envelope(payload))).toThrow(
+      "configuration set",
+    );
+  });
+  it("rejects a bounce with no affected recipients", () => {
+    const payload = event();
+    payload.bounce.bouncedRecipients = [];
+    expect(() => normalizeSesFeedback(envelope(payload))).toThrow("recipients");
+  });
+});
diff --git a/packages/platform/src/email/ses-feedback.ts b/packages/platform/src/email/ses-feedback.ts
new file mode 100644
index 0000000..8b884ec
--- /dev/null
+++ b/packages/platform/src/email/ses-feedback.ts
@@ -0,0 +1,133 @@
+import { SnsEnvelope } from "./sns-feedback.verifier";
+
+export interface EmailFeedback {
+  eventId: string;
+  providerMessageId: string;
+  type: string;
+  occurredAt: Date;
+  identityDomain: string;
+  configurationSet: string;
+  recipients: string[];
+  suppressionReason?: "HARD_BOUNCE" | "COMPLAINT";
+}
+
+const object = (value: unknown): Record<string, any> => {
+  if (!value || typeof value !== "object" || Array.isArray(value))
+    throw new Error("Invalid SES object");
+  return value as Record<string, any>;
+};
+
+export function normalizeSesFeedback(envelope: SnsEnvelope): EmailFeedback {
+  if (envelope.Type !== "Notification")
+    throw new Error("Expected SNS notification");
+  const event = object(JSON.parse(envelope.Message));
+  const mail = object(event.mail);
+  const topic = /^arn:aws:sns:([^:]+):(\d{12}):/.exec(envelope.TopicArn);
+  const identity =
+    /^arn:aws:ses:([^:]+):(\d{12}):identity\/([a-z0-9.-]+)$/.exec(
+      mail.sourceArn,
+    );
+  if (
+    !topic ||
+    !identity ||
+    identity[1] !== topic[1] ||
+    identity[2] !== topic[2] ||
+    mail.sendingAccountId !== topic[2]
+  ) {
+    throw new Error("SES source account or identity mismatch");
+  }
+  if (
+    typeof mail.messageId !== "string" ||
+    !mail.messageId ||
+    mail.messageId.length > 256
+  )
+    throw new Error("Missing SES message ID");
+  const type = event.eventType;
+  if (
+    ![
+      "Send",
+      "Delivery",
+      "Bounce",
+      "Complaint",
+      "Reject",
+      "DeliveryDelay",
+      "Rendering Failure",
+    ].includes(type)
+  ) {
+    throw new Error("Unsupported SES event type");
+  }
+  const tags = object(mail.tags);
+  const configurationSets = tags["ses:configuration-set"];
+  if (
+    !Array.isArray(configurationSets) ||
+    configurationSets.length !== 1 ||
+    typeof configurationSets[0] !== "string"
+  ) {
+    throw new Error("Missing SES configuration set");
+  }
+  let recipients: unknown = mail.destination;
+  let timestamp: unknown = mail.timestamp;
+  let suppressionReason: EmailFeedback["suppressionReason"];
+  if (type === "Bounce") {
+    const bounce = object(event.bounce);
+    if (!["Permanent", "Transient", "Undetermined"].includes(bounce.bounceType))
+      throw new Error("Invalid bounce type");
+    recipients = Array.isArray(bounce.bouncedRecipients)
+      ? bounce.bouncedRecipients.map(
+          (entry: unknown) => object(entry).emailAddress,
+        )
+      : undefined;
+    timestamp = bounce.timestamp;
+    if (bounce.bounceType === "Permanent") suppressionReason = "HARD_BOUNCE";
+  } else if (type === "Complaint") {
+    const complaint = object(event.complaint);
+    recipients = Array.isArray(complaint.complainedRecipients)
+      ? complaint.complainedRecipients.map(
+          (entry: unknown) => object(entry).emailAddress,
+        )
+      : undefined;
+    timestamp = complaint.timestamp;
+    // A "not-spam" report must never clear suppression automatically.
+    if (complaint.complaintFeedbackType !== "not-spam")
+      suppressionReason = "COMPLAINT";
+  } else if (type === "Delivery") {
+    const delivery = object(event.delivery);
+    recipients = delivery.recipients;
+    timestamp = delivery.timestamp;
+  } else if (type === "DeliveryDelay") {
+    const delay = object(event.deliveryDelay);
+    recipients = Array.isArray(delay.delayedRecipients)
+      ? delay.delayedRecipients.map(
+          (entry: unknown) => object(entry).emailAddress,
+        )
+      : undefined;
+    timestamp = delay.timestamp;
+  }
+  if (
+    !Array.isArray(recipients) ||
+    recipients.length === 0 ||
+    recipients.length > 50 ||
+    recipients.some(
+      (email) =>
+        typeof email !== "string" ||
+        email.length > 254 ||
+        !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email),
+    )
+  )
+    throw new Error("Invalid SES recipients");
+  const occurredAt = new Date(typeof timestamp === "string" ? timestamp : "");
+  if (!Number.isFinite(occurredAt.getTime()))
+    throw new Error("Invalid SES timestamp");
+  return {
+    eventId: `${envelope.TopicArn}:${envelope.MessageId}`,
+    providerMessageId: mail.messageId,
+    type,
+    occurredAt,
+    identityDomain: identity[3],
+    configurationSet: configurationSets[0],
+    recipients: [
+      ...new Set((recipients as string[]).map((email) => email.toLowerCase())),
+    ],
+    suppressionReason,
+  };
+}
