+   * Invite someone to an organization. Only an org:admin can invite. When the
+   * email already belongs to an enrolled user, they join directly; otherwise
+   * a pending AuthInvitation is recorded — never a half-built membership or
+   * a fabricated user. Re-inviting while one is pending returns it.
+   *
+   * Invitation emails are not sent here; delivery rides the organization's
+   * email policy once it is enabled.
+   */
+  async inviteMember(
+    organizationId: string,
+    inviterId: string,
+    email: string,
+    role: string,
+  ): Promise<InvitationOutcome> {
+    const normalizedRole = OrganizationService.assertRole(role);
+    await this.assertAdmin(organizationId, inviterId);
+    const normalizedEmail = email.trim().toLowerCase();
+    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(normalizedEmail)) {
+      throw new BadRequestException("Invalid email address.");
+    }
+
+    const user = await this.userRepository.findByAuthEmail(normalizedEmail);
+    if (user) {
+      const existing = await this.organizationRepository.findMembership(
+        organizationId,
+        user.id,
+      );
+      if (existing) {
+        throw new ConflictException("That person is already a member.");
+      }
+      await this.organizationRepository.addMembershipByIds(
+        organizationId,
+        user.id,
+        normalizedRole,
+      );
+      return { kind: "added" };
+    }
+
+    const pending = await this.organizationRepository.findPendingInvitation(
+      organizationId,
+      normalizedEmail,
+    );
+    if (pending) {
+      return { kind: "invited", invitationId: pending.id };
+    }
+    const invitation = await this.organizationRepository.createInvitation({
+      organizationId,
+      inviterId,
+      email: normalizedEmail,
+      role: normalizedRole,
+      expiresAt: new Date(Date.now() + INVITATION_TTL_MS),
+    });
+    return { kind: "invited", invitationId: invitation.id };
+  }
+
+  /**
+   * Accept an invitation. The accepting mailbox must be verified: a pending
+   * invitation never grants membership on an unverified claim. The membership
+   * and the invitation's closure happen in one transaction.
+   */
+  async acceptInvitation(invitationId: string, userId: string): Promise<void> {
+    const invitation =
+      await this.organizationRepository.findInvitationById(invitationId);
+    if (!invitation || invitation.status !== "pending") {
+      throw new NotFoundException("Invitation not found.");
+    }
+    if (invitation.expiresAt.getTime() <= Date.now()) {
+      await this.organizationRepository.expireInvitation(invitationId);
+      throw new ConflictException("That invitation has expired.");
+    }
+    const user = await this.userRepository.findById(userId);
+    const email = user?.authEmail?.trim().toLowerCase() ?? null;
+    if (!user || !email || email !== invitation.email || !user.authEmailVerified) {
+      throw new ForbiddenException(
+        "Accepting this invitation requires the invited, verified mailbox.",
+      );
+    }
+    await this.organizationRepository.acceptInvitation(invitationId, userId);
+  }
+
+  /** Cancel a pending invitation. Only an org:admin can revoke. */
+  async revokeInvitation(
+    organizationId: string,
+    invitationId: string,
+    actorId: string,
+  ): Promise<void> {
+    await this.assertAdmin(organizationId, actorId);
+    const invitation =
+      await this.organizationRepository.findInvitationById(invitationId);
+    if (
+      !invitation ||
+      invitation.organizationId !== organizationId ||
+      invitation.status !== "pending"
+    ) {
+      throw new NotFoundException("Invitation not found.");
+    }
+    await this.organizationRepository.revokeInvitation(invitationId);
+  }
+
+  /** Pending invitations for an organization. Org admins only. */
+  async listPendingInvitations(
+    organizationId: string,
+    actorId: string,
+  ): Promise<AuthInvitation[]> {
+    await this.assertAdmin(organizationId, actorId);
+    return this.organizationRepository.listPendingInvitations(organizationId);
+  }
+
+  private static assertRole(role: string): OrganizationRole {
+    if (
+      role !== "org:admin" &&
+      role !== "org:member"
+    ) {
+      throw new ConflictException(
+        `Unsupported role "${role}". Expected org:admin or org:member.`,
+      );
+    }
+    return role;
+  }
+
+  private async assertAdmin(
+    organizationId: string,
+    userId: string,
+  ): Promise<void> {
+    const membership = await this.organizationRepository.findMembership(
+      organizationId,
+      userId,
+    );
+    if (!membership || membership.role !== "org:admin") {
+      throw new ForbiddenException(
+        "Only an organization administrator can do that.",
+      );
+    }
+  }
