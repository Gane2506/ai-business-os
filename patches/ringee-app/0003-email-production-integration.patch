diff --git a/packages/platform/src/ai-agents/providers/openrouter.provider.test.ts b/packages/platform/src/ai-agents/providers/openrouter.provider.test.ts
new file mode 100644
index 0000000..5b7b038
--- /dev/null
+++ b/packages/platform/src/ai-agents/providers/openrouter.provider.test.ts
@@ -0,0 +1,116 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const mock = vi.hoisted(() => ({
+  config: {
+    AI_PROVIDER: "openrouter",
+    OPENROUTER_API_KEY: "router-test-key",
+    OPENROUTER_DEFAULT_MODEL: "openai/gpt-5.4-mini",
+    OPENROUTER_SUMMARY_MODEL: "openai/gpt-5.4-mini",
+    OPENAI_API_KEY: "",
+    OPENAI_DEFAULT_MODEL: "gpt-5.4-mini",
+    OPENAI_SUMMARY_MODEL: "gpt-5.4-mini",
+  },
+  clients: [] as Array<Record<string, unknown>>,
+  requests: [] as Array<Record<string, unknown>>,
+}));
+
+vi.mock("@ringee/configuration", () => ({ apiConfiguration: mock.config }));
+vi.mock("openai", () => ({
+  default: class {
+    chat = {
+      completions: {
+        create: async (request: Record<string, unknown>) => {
+          mock.requests.push(request);
+          if (request.stream) {
+            return (async function* () {
+              yield { choices: [{ delta: { content: "hello" }, finish_reason: "stop" }] };
+              yield { choices: [], usage: { prompt_tokens: 10, completion_tokens: 2 } };
+            })();
+          }
+          return {
+            choices: [{ message: { content: "summary", tool_calls: [] } }],
+            usage: { prompt_tokens: 7, completion_tokens: 2 },
+          };
+        },
+      },
+    };
+    constructor(options: Record<string, unknown>) {
+      mock.clients.push(options);
+    }
+  },
+}));
+
+import { OpenAiProvider } from "./openai.provider";
+import { OpenRouterProvider } from "./openrouter.provider";
+import { OpenaiService } from "../../ai/openai/openai.service";
+
+beforeEach(() => {
+  mock.clients.length = 0;
+  mock.requests.length = 0;
+  mock.config.OPENROUTER_API_KEY = "router-test-key";
+  mock.config.OPENROUTER_DEFAULT_MODEL = "openai/gpt-5.4-mini";
+  mock.config.OPENROUTER_SUMMARY_MODEL = "openai/gpt-5.4-mini";
+  mock.config.OPENAI_API_KEY = "";
+  mock.config.AI_PROVIDER = "openrouter";
+});
+
+describe("OpenRouter text provider", () => {
+  it("constructs without an OpenAI key and creates only the selected client on use", async () => {
+    const openrouter = new OpenRouterProvider();
+    const openai = new OpenAiProvider();
+    expect(mock.clients).toHaveLength(0);
+    const result = await openrouter.summarize({ system: "summarize", messages: [] });
+    expect(result.summary).toBe("summary");
+    expect(result.usage?.model).toBe("openai/gpt-5.4-mini");
+    expect(mock.clients).toEqual([
+      { apiKey: "router-test-key", baseURL: "https://openrouter.ai/api/v1" },
+    ]);
+    expect(mock.requests[0].model).toBe("openai/gpt-5.4-mini");
+    expect(openai.name).toBe("openai");
+  });
+
+  it("streams text and tools through the OpenAI-compatible API", async () => {
+    const provider = new OpenRouterProvider();
+    const events: unknown[] = [];
+    for await (const event of provider.stream({
+      system: "system",
+      messages: [{ role: "user", content: "hello" }],
+      tools: [{ name: "lookup", description: "Find", parameters: { type: "object" } }],
+    })) events.push(event);
+    expect(events).toContainEqual({ type: "text_delta", delta: "hello" });
+    expect(events[events.length - 1]).toMatchObject({ type: "completed", finishReason: "stop" });
+    expect(mock.requests[0].tools).toBeDefined();
+    expect(mock.requests[0].model).toBe("openai/gpt-5.4-mini");
+  });
+
+  it("fails without its key and refuses an unpriced model", async () => {
+    mock.config.OPENROUTER_API_KEY = "";
+    await expect(new OpenRouterProvider().summarize({ system: "x", messages: [] }))
+      .rejects.toThrow(/OPENROUTER_API_KEY/);
+    mock.config.OPENROUTER_API_KEY = "router-test-key";
+    mock.config.OPENROUTER_SUMMARY_MODEL = "unknown/unpriced";
+    await expect(new OpenRouterProvider().summarize({ system: "x", messages: [] }))
+      .rejects.toThrow(/no reviewed Ringee token pricing/);
+    expect(mock.requests).toHaveLength(0);
+  });
+
+  it("retains explicit OpenAI selection", async () => {
+    mock.config.OPENAI_API_KEY = "openai-test-key";
+    await new OpenAiProvider().summarize({ system: "x", messages: [] });
+    expect(mock.clients).toEqual([{ apiKey: "openai-test-key" }]);
+    expect(mock.requests[0].model).toBe("gpt-5.4-mini");
+  });
+
+  it("routes legacy text through OpenRouter and keeps its client lazy", async () => {
+    const service = new OpenaiService();
+    expect(mock.clients).toHaveLength(0);
+    const result = await service.generateWithTools({
+      messages: [],
+      systemPrompt: "system",
+      tools: [],
+    });
+    expect(result).toEqual({ type: "text", text: "summary" });
+    expect(mock.clients[0]).toMatchObject({ baseURL: "https://openrouter.ai/api/v1" });
+    expect(mock.requests[0].model).toBe("openai/gpt-5.4-mini");
+  });
+});
diff --git a/packages/platform/src/ai-agents/providers/openrouter.provider.ts b/packages/platform/src/ai-agents/providers/openrouter.provider.ts
new file mode 100644
index 0000000..2c3f260
--- /dev/null
+++ b/packages/platform/src/ai-agents/providers/openrouter.provider.ts
@@ -0,0 +1,24 @@
+import { Injectable } from "@nestjs/common";
+import OpenAI from "openai";
+import { apiConfiguration } from "@ringee/configuration";
+import { OpenAiProvider } from "./openai.provider";
+import { createTextAiClient, reviewedOpenRouterModel } from "./text-ai.client";
+
+/** OpenRouter's OpenAI-compatible text chat and tool-calling adapter. */
+@Injectable()
+export class OpenRouterProvider extends OpenAiProvider {
+  override readonly name = "openrouter";
+
+  protected override createClient(): OpenAI {
+    return createTextAiClient("openrouter");
+  }
+
+  protected override get chatModel(): string {
+    return reviewedOpenRouterModel(apiConfiguration.OPENROUTER_DEFAULT_MODEL);
+  }
+
+  protected override get summaryModel(): string {
+    return reviewedOpenRouterModel(apiConfiguration.OPENROUTER_SUMMARY_MODEL);
+  }
+
+}
