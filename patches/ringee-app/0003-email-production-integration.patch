+      where: { domainId_stream: { domainId, stream } },
+      data: { ...status, checkedAt: new Date() },
+    });
+  }
+  findSuppression(emails: string[]) {
+    return this.prisma.emailSuppression.findFirst({
+      where: { email: { in: emails } },
+    });
+  }
+  findPreference(
+    domainId: string,
+    emails: string[],
+    category: EmailPreferenceCategory,
+  ) {
+    return this.prisma.emailPreference.findFirst({
+      where: { domainId, email: { in: emails }, category },
+    });
+  }
+  async beginDelivery(input: {
+    domainId: string;
+    stream: EmailStream;
+    operationKey: string;
+    fingerprint: string;
+    recipients: string[];
+  }) {
+    const where = {
+      OR: [
+        { operationKey: input.operationKey },
+        {
+          domainId: input.domainId,
+          fingerprint: input.fingerprint,
+          status: { in: ["SENDING", "UNKNOWN"] },
+        },
+      ],
+    };
+    const existing = await this.prisma.emailDelivery.findFirst({ where });
+    if (existing) {
+      if (
+        existing.operationKey === input.operationKey &&
+        existing.fingerprint === input.fingerprint &&
+        existing.status === "REJECTED"
+      ) {
+        const retry = await this.prisma.emailDelivery.updateMany({
+          where: { id: existing.id, status: "REJECTED" },
+          data: { status: "SENDING" },
+        });
+        return {
+          delivery: { ...existing, status: "SENDING" },
+          claimed: retry.count === 1,
+        };
+      }
+      return { delivery: existing, claimed: false };
+    }
+    try {
+      return {
+        delivery: await this.prisma.emailDelivery.create({ data: input }),
+        claimed: true,
+      };
