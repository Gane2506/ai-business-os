@@ -0,0 +1,59 @@
+import type {
+  NextFunction,
+  Request as ExpressRequest,
+  Response as ExpressResponse,
+} from "express";
+import type { BetterAuthRuntime } from "@ringee/platform";
+
+/**
+ * Mount the Better Auth request handler as plain Express middleware.
+ *
+ * The runtime speaks Web Request/Response, so this adapter converts the
+ * Express request (raw body captured by `express.raw`) and writes the
+ * resulting response back, preserving multi-value `set-cookie` headers.
+ * The runtime itself only serves its explicit sign-in/sign-out whitelist
+ * and returns 404 for every other path, method or origin.
+ */
+export function createAuthRequestMiddleware(runtime: BetterAuthRuntime) {
+  return async function authRequestMiddleware(
+    req: ExpressRequest,
+    res: ExpressResponse,
+    next: NextFunction,
+  ): Promise<void> {
+    try {
+      const headers = new Headers();
+      for (const [name, value] of Object.entries(req.headers)) {
+        if (value === undefined) continue;
+        if (Array.isArray(value)) {
+          for (const entry of value) headers.append(name, entry);
+        } else {
+          headers.append(name, value);
+        }
+      }
+      const url = new URL(
+        req.originalUrl,
+        `${req.protocol}://${req.get("host")}`,
+      );
+      const init: RequestInit = { method: req.method, headers };
+      if (
+        req.method !== "GET" &&
+        req.method !== "HEAD" &&
+        Buffer.isBuffer(req.body)
+      ) {
+        init.body = new Uint8Array(req.body);
+      }
+      const response = await runtime.handle(new Request(url, init));
+
+      res.status(response.status);
+      response.headers.forEach((value, key) => {
+        // `forEach` joins repeated headers; set-cookie must stay separate.
+        if (key.toLowerCase() !== "set-cookie") res.setHeader(key, value);
+      });
+      const setCookies = response.headers.getSetCookie();
+      if (setCookies.length > 0) res.setHeader("set-cookie", setCookies);
+      res.send(Buffer.from(await response.arrayBuffer()));
+    } catch (error) {
+      next(error);
+    }
+  };
+}
