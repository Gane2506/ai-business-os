+import type { CurrentUserData } from "./ownership.types";
+
+/**
+ * Nest DI token for the request-scoped Better Auth session reader.
+ * Provided by the backend application module; guards inject this token,
+ * never the Better Auth SDK.
+ */
+export const AUTH_RUNTIME_TOKEN = "RINGEE_AUTH_RUNTIME";
+
+/**
+ * Express request field carrying the verified RingeeAuthPrincipal.
+ * Set once per request by the global AuthGuard; decorators and
+ * route-scoped guards read it instead of provider-specific fields.
+ */
+export const AUTH_PRINCIPAL_REQUEST_KEY = "principal";
+
+/** Provider-neutral values. No bearer, metadata, Clerk ID or DB secret crosses this boundary. */
+export interface VerifiedAuthSession {
+  id: string;
+  userId: string;
+}
+export interface AuthPrincipalDto {
+  user: {
+    id: string;
+    email: string;
+    emailVerified: boolean;
+    name: string;
+    imageUrl: string | null;
+  };
+  organization: {
+    id: string;
+    name: string;
+    slug: string | null;
+    imageUrl: string | null;
+    role: "org:admin" | "org:member";
+  } | null;
+  phoneAccess: { required: boolean; verified: boolean };
+  expiresAt: string;
+}
+export interface RingeeAuthPrincipal extends CurrentUserData {
+  sessionId: string;
+  activeOrgId: string | null;
+  activeOrgRole: "org:admin" | "org:member" | null;
+  canCall: boolean;
+  dto: AuthPrincipalDto;
+}
+export interface AuthSessionReader {
+  getVerifiedSession(headers: Headers): Promise<VerifiedAuthSession | null>;
+}
