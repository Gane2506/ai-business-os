index 0000000..a487cb3
--- /dev/null
+++ b/packages/services/src/services/auth-principal.service.spec.ts
@@ -0,0 +1,175 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import type { AuthSessionRepository } from "@ringee/database";
+import { AuthPrincipalService } from "./auth-principal.service";
+
+const USER = "10000000-0000-4000-8000-000000000001";
+const SESSION = "20000000-0000-4000-8000-000000000001";
+const ORG = "30000000-0000-4000-8000-000000000001";
+function fixture() {
+  const snapshot = {
+    session: {
+      id: SESSION,
+      userId: USER,
+      expiresAt: new Date(Date.now() + 60000),
+      activeOrganizationId: null as string | null,
+      user: {
+        id: USER,
+        authEmail: "enrolled@example.invalid",
+        authName: "Enrolled",
+        authEmailVerified: true,
+        imageUrl: null,
+        blockedAt: null as Date | null,
+        encryptionKey: "synthetic-enrollment-key",
+        phoneRequired: true,
+        phoneVerified: true,
+        phoneNumber: "+14165550100",
+        canCall: false,
+        emails: [
+          {
+            email: "enrolled@example.invalid",
+            status: "verified",
+            isPrimary: true,
+          },
+        ],
+      },
+    },
+    membership: null as null | {
+      userId: string;
+      organizationId: string;
+      role: string;
+      organization: { id: string; name: string; slug: null; imageUrl: null };
+    },
+  };
+  let reads = 0;
+  const findPrincipalSnapshot = async () => {
+    reads += 1;
+    return snapshot;
+  };
+  const service = new AuthPrincipalService({
+    findPrincipalSnapshot,
+  } as unknown as AuthSessionRepository);
+  const reader = {
+    getVerifiedSession: async () => ({ id: SESSION, userId: USER }),
+  };
+  return { snapshot, service, reader, reads: () => reads };
+}
+describe("canonical auth principal boundary", () => {
+  it("returns canonical UUID personal scope without provider IDs or secrets", async () => {
+    const f = fixture();
+    const principal = await f.service.resolve(f.reader, new Headers());
+    assert.equal(principal.id, USER);
+    assert.equal(principal.activeOrgId, null);
+    assert.equal(principal.canCall, false);
+    assert.equal(principal.dto.organization, null);
+    assert.doesNotMatch(
+      JSON.stringify(principal),
+      /clerkId|encryptionKey|token|password|privateMetadata/,
+    );
+    assert.doesNotThrow(() => f.service.requireProductAccess(principal));
+  });
+  it("requires a verified provider session before database access", async () => {
+    const f = fixture();
+    await assert.rejects(
+      f.service.resolve(
+        { getVerifiedSession: async () => null },
+        new Headers(),
+      ),
+      /Session unavailable/,
+    );
+    await assert.rejects(
+      f.service.resolve(
+        { getVerifiedSession: async () => ({ id: "forged", userId: USER }) },
+        new Headers(),
+      ),
+    );
+    assert.equal(f.reads(), 0);
+  });
+  for (const reason of [
+    "blocked",
+    "legacy",
+    "unverified",
+    "missingPrimary",
+    "changedEmail",
+    "missingInitialization",
+  ])
+    it("denies " + reason + " enrollment", async () => {
+      const f = fixture(),
+        user = f.snapshot.session.user;
+      if (reason === "blocked") user.blockedAt = new Date();
+      if (reason === "legacy") user.authName = "";
+      if (reason === "unverified") user.emails[0].status = "pending";
+      if (reason === "missingPrimary") user.emails[0].isPrimary = false;
+      if (reason === "changedEmail") user.authEmail = "changed@example.invalid";
+      if (reason === "missingInitialization") user.encryptionKey = "";
+      await assert.rejects(
+        f.service.resolve(f.reader, new Headers()),
+        /Account unavailable/,
+      );
+    });
+  it("denies expired, revoked or mismatched database sessions", async () => {
+    const f = fixture();
+    f.snapshot.session.expiresAt = new Date(0);
+    await assert.rejects(
+      f.service.resolve(f.reader, new Headers()),
+      /Session unavailable/,
+    );
+    f.snapshot.session.expiresAt = new Date(Date.now() + 60000);
+    f.snapshot.session.userId = ORG;
+    await assert.rejects(
+      f.service.resolve(f.reader, new Headers()),
+      /Session unavailable/,
+    );
+  });
+  it("never falls back to personal when selected membership is invalid", async () => {
+    const f = fixture();
+    f.snapshot.session.activeOrganizationId = ORG;
+    await assert.rejects(
+      f.service.resolve(f.reader, new Headers()),
+      /Workspace unavailable/,
+    );
+  });
+  it("observes downgrade and revocation on the next request", async () => {
+    const f = fixture();
+    f.snapshot.session.activeOrganizationId = ORG;
+    f.snapshot.membership = {
+      userId: USER,
+      organizationId: ORG,
+      role: "org:admin",
+      organization: { id: ORG, name: "Org", slug: null, imageUrl: null },
+    };
+    assert.equal(
+      (await f.service.resolve(f.reader, new Headers())).activeOrgRole,
+      "org:admin",
+    );
+    f.snapshot.membership.role = "org:member";
+    assert.equal(
+      (await f.service.resolve(f.reader, new Headers())).activeOrgRole,
+      "org:member",
+    );
+    f.snapshot.membership.role = "super-org:admin";
+    await assert.rejects(
+      f.service.resolve(f.reader, new Headers()),
+      /Workspace unavailable/,
+    );
+    f.snapshot.membership = null;
+    await assert.rejects(
+      f.service.resolve(f.reader, new Headers()),
+      /Workspace unavailable/,
+    );
+    assert.equal(f.reads(), 4);
+  });
+  it("keeps phone onboarding mandatory and honors only the stored waiver", async () => {
+    const f = fixture();
+    f.snapshot.session.user.phoneVerified = false;
+    const principal = await f.service.resolve(f.reader, new Headers());
+    assert.throws(
+      () => f.service.requireProductAccess(principal),
+      /Phone verification required/,
+    );
+    f.snapshot.session.user.phoneRequired = false;
+    assert.throws(() => f.service.requireProductAccess(principal));
+    const waived = await f.service.resolve(f.reader, new Headers());
+    assert.doesNotThrow(() => f.service.requireProductAccess(waived));
+  });
+});
diff --git a/packages/services/src/services/auth-principal.service.ts b/packages/services/src/services/auth-principal.service.ts
new file mode 100644
index 0000000..bb10476
--- /dev/null
+++ b/packages/services/src/services/auth-principal.service.ts
@@ -0,0 +1,115 @@
+import {
+  ForbiddenException,
+  Inject,
+  Injectable,
+  UnauthorizedException,
+} from "@nestjs/common";
+import type { AuthSessionRepository } from "@ringee/database";
+import type { AuthSessionReader, RingeeAuthPrincipal } from "@ringee/platform";
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+/**
+ * Resolve on every request/stream revalidation.
+ * A provider session is authentication only; current domain rows authorize Ringee.
+ */
+@Injectable()
+export class AuthPrincipalService {
+  constructor(
+    @Inject("RINGEE_AUTH_SESSION_REPOSITORY")
+    private readonly sessions: AuthSessionRepository,
+  ) {}
+
+  async resolve(
+    reader: AuthSessionReader,
+    headers: Headers,
+  ): Promise<RingeeAuthPrincipal> {
+    const verified = await reader.getVerifiedSession(headers);
+    if (!verified || !UUID.test(verified.id) || !UUID.test(verified.userId)) {
+      throw new UnauthorizedException("Session unavailable");
+    }
+    const snapshot = await this.sessions.findPrincipalSnapshot(
+      verified.id,
+      verified.userId,
+      new Date(),
+    );
+    if (
+      !snapshot ||
+      snapshot.session.userId !== verified.userId ||
+      snapshot.session.user.id !== verified.userId ||
+      snapshot.session.expiresAt.getTime() <= Date.now()
+    ) {
+      throw new UnauthorizedException("Session unavailable");
+    }
+    const { session, membership } = snapshot;
+    const user = session.user;
+    const email = user.authEmail;
+    const primary = user.emails.filter((row) => row.isPrimary);
+    if (
+      user.blockedAt !== null ||
+      !email ||
+      email !== email.trim().toLowerCase() ||
+      !user.authName?.trim() ||
+      !user.encryptionKey ||
+      primary.length !== 1 ||
+      primary[0].email !== email ||
+      !user.authEmailVerified ||
+      primary[0].status !== "verified"
+    ) {
+      throw new ForbiddenException("Account unavailable");
+    }
+    const organizationId = session.activeOrganizationId;
+    if (
+      organizationId !== null &&
+      (!UUID.test(organizationId) ||
+        !membership ||
+        membership.userId !== user.id ||
+        membership.organizationId !== organizationId ||
+        membership.organization.id !== organizationId ||
+        !["org:admin", "org:member"].includes(membership.role))
+    ) {
+      // Never silently turn an invalid explicit organization into personal access.
+      throw new ForbiddenException("Workspace unavailable");
+    }
+    const role =
+      organizationId === null
+        ? null
+        : (membership!.role as "org:admin" | "org:member");
+    const dto = {
+      user: {
+        id: user.id,
+        email,
+        emailVerified: true,
+        name: user.authName,
+        imageUrl: user.imageUrl,
+      },
+      organization:
+        organizationId === null
+          ? null
+          : { ...membership!.organization, role: role! },
+      phoneAccess: {
+        required: user.phoneRequired,
+        verified: user.phoneVerified && !!user.phoneNumber,
+      },
+      expiresAt: session.expiresAt.toISOString(),
+    };
+    return {
+      id: user.id,
+      sessionId: session.id,
+      activeOrgId: organizationId,
+      activeOrgRole: role,
+      canCall: user.canCall,
+      dto,
+    };
+  }
+
+  /** Product routes must call this; onboarding routes may read the principal DTO. */
+  requireProductAccess(principal: RingeeAuthPrincipal): void {
+    if (
+      principal.dto.phoneAccess.required &&
+      !principal.dto.phoneAccess.verified
+    ) {
+      throw new ForbiddenException("Phone verification required");
+    }
+  }
+}
diff --git a/scripts/auth-runtime.test.cjs b/scripts/auth-runtime.test.cjs
new file mode 100644
index 0000000..dad4140
--- /dev/null
+++ b/scripts/auth-runtime.test.cjs
@@ -0,0 +1,121 @@
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+const { readFileSync, existsSync } = require("node:fs");
+const { resolve, join } = require("node:path");
+const { randomBytes } = require("node:crypto");
+// Synthetic startup environment for the compiled application configuration.
+// Requiring the compiled better-auth runtime pulls in @ringee/configuration,
+// which validates required settings at import time and exits(1) listing every
+// missing key. These deterministic placeholders satisfy that validation only;
+// no step below connects to a provider, sends a message, or spends money.
+// Existing values (e.g. CI's disposable DATABASE_URL) are never overwritten.
+for (const [key, value] of Object.entries({
+  DATABASE_URL: "postgresql://smoke:smoke@127.0.0.1:1/smoke",
+  PORT: "3101",
+  WHATSAPP_PHONE_ID: "smoke-test",
+  WHATSAPP_PHONE_NUMBER: "smoke-test",
+  WHATSAPP_TOKEN: "smoke-test",
+  WHATSAPP_VERIFY_TOKEN: "smoke-test",
+  FRONTEND_URL: "https://calls.connectxmedia.com",
+  BACKEND_URL: "https://calls-api.connectxmedia.com",
+  PUBLIC_BACKEND_URL: "https://calls-api.connectxmedia.com",
+  AI_PROVIDER: "openrouter",
+  OPENROUTER_API_KEY: "smoke-test",
+  REDIS_URL: "redis://127.0.0.1:1",
+  AWS_SES_REGION: "ca-central-1",
+  EMAIL_FROM_NAME: "Smoke Test",
+  EMAIL_FROM_ADDRESS: "smoke-test@example.invalid",
+  CLERK_WEBHOOK_SIGNING_SECRET: "smoke-test",
+  APP_ENCRYPTION_SECRET: "smoke-test",
+  TELNYX_API_KEY: "smoke-test",
+  TELNYX_CONNECTION_ID: "smoke-test",
+  STRIPE_SECRET_KEY: "smoke-test",
+  STRIPE_WEBHOOK_SECRET: "smoke-test",
+})) {
+  process.env[key] ??= value;
+}
+const root = resolve(__dirname, "..");
+for (const owner of ["apps/backend", "apps/orchestrator"]) {
+  test(
+    owner + " compiled native ESM asset resolves pinned runtime",
+    async () => {
+      const directory = join(
+        root,
+        owner,
+        "dist/packages/platform/src/auth/better-auth",
+      );
+      assert.ok(
+        existsSync(join(directory, "better-auth.runtime.js")),
+        "Build the actual application first",
+      );
+      const source = readFileSync(join(directory, "native-loader.cjs"), "utf8");
+      assert.ok(source.includes('import("./runtime.mjs")'));
+      assert.ok(!source.includes('require("better-auth'));
+      const { createRuntime } = await require(
+        join(directory, "native-loader.cjs"),
+      ).loadRuntime();
+      const configuration = {
+        secret: randomBytes(48).toString("base64url"),
+        baseURL: "https://calls-api.connectxmedia.com",
+        trustedOrigins: ["https://calls.connectxmedia.com"],
+      };
+      assert.throws(() => createRuntime({}, { ...configuration, secret: "" }));
+      assert.throws(() =>
+        createRuntime(
+          {},
+          {
+            ...configuration,
+            trustedOrigins: ["https://evil.connectxmedia.com"],
+          },
+        ),
+      );
+      assert.throws(() =>
+        createRuntime(
+          {},
+          { ...configuration, baseURL: "http://calls-api.connectxmedia.com" },
+        ),
+      );
+      const { createBetterAuthRuntime } = require(
+        join(directory, "better-auth.runtime.js"),
+      );
+      const previousSecret = process.env.BETTER_AUTH_SECRET;
+      let runtime;
+      try {
+        process.env.BETTER_AUTH_SECRET = configuration.secret;
+        runtime = await createBetterAuthRuntime({});
+      } finally {
+        if (previousSecret === undefined) delete process.env.BETTER_AUTH_SECRET;
+        else process.env.BETTER_AUTH_SECRET = previousSecret;
+      }
+      for (const path of [
+        "sign-up/email",
+        "reset-password",
+        "request-password-reset",
+        "change-password",
+        "get-session",
+        "organization/create",
+        "delete-user",
+      ]) {
+        const response = await runtime.handle(
+          new Request(configuration.baseURL + "/api/auth/" + path, {
+            method: "POST",
+          }),
+        );
+        assert.equal(response.status, 404);
+      }
+      for (const origin of [
+        undefined,
+        "https://evil.connectxmedia.com",
+        "https://calls.connectxmedia.com.evil.invalid",
+      ]) {
+        const response = await runtime.handle(
+          new Request(configuration.baseURL + "/api/auth/sign-out", {
+            method: "POST",
+            headers: origin ? { origin } : {},
+          }),
+        );
+        assert.equal(response.status, 403);
+      }
+    },
+  );
+}
diff --git a/scripts/copy-auth-runtime.cjs b/scripts/copy-auth-runtime.cjs
new file mode 100644
index 0000000..028a473
--- /dev/null
+++ b/scripts/copy-auth-runtime.cjs
@@ -0,0 +1,27 @@
+const { copyFileSync, mkdirSync, existsSync } = require("node:fs");
+const { resolve, join } = require("node:path");
+const root = resolve(__dirname, "..");
+const owner = process.argv[2];
+if (!["packages/platform", "apps/backend", "apps/orchestrator"].includes(owner))
+  throw new Error("Unknown build owner");
+const source = join(root, "packages/platform/src/auth/better-auth");
+const emittedRoots =
+  owner === "packages/platform"
+    ? ["packages/platform/src", "platform/src", "src", ""]
+    : ["packages/platform/src"];
+const destinations = emittedRoots
+  .map((path) => join(root, owner, "dist", path, "auth/better-auth"))
+  .filter((path) => existsSync(join(path, "better-auth.runtime.js")));
+if (destinations.length !== 1)
+  throw new Error(
+    "Expected one compiled native loader bridge before copying assets",
+  );
+const destination = destinations[0];
+mkdirSync(destination, { recursive: true });
+for (const name of [
+  "native-loader.cjs",
+  "runtime.mjs",
+  "hashed-session-adapter.mjs",
+]) {
+  copyFileSync(join(source, name), join(destination, name));
+}
